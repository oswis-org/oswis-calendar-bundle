{# Kontextové PODMENU turnusu/akce — TÝŽ pruh na detailu akce i na všech jejích podstránkách
   (účastníci / check-in / program / rozpis služeb), aby šlo mezi nimi přecházet bez vracení se na
   detail a aby bylo vidět „kde jsem". Renderuje se jako tab-bar (aktivní = tučně + modré podtržení).

   Parametry (include with { ... } only):
     - eventSlug  (povinné) — slug turnusu pro odkazy
     - eventName  (nepovinné) — popisek turnusu vlevo
     - current    (nepovinné) — klíč aktivní položky: overview|participants|bands|board|meals|checkin|program|roster

   Funkce týmu ZÁMĚRNĚ není v pruhu — je to globální číselník rolí (bez eventSlug), ne podstránka
   turnusu; odkaz na něj žije na stránce Rozpis služeb a v úvodce. #}
{% set _items = [
    { key: 'overview', label: 'Přehled', url: path('oswis_org_oswis_calendar_web_admin_event', { eventSlug: eventSlug }) },
    { key: 'participants', label: 'Účastníci', url: path('oswis_org_oswis_calendar_web_admin_participants_list', { eventSlug: eventSlug, participantCategorySlug: 'attendee' }) },
    { key: 'bands', label: 'Pásky', url: path('oswis_org_oswis_calendar_web_admin_participant_groups', { eventSlug: eventSlug }) },
    { key: 'board', label: 'Nástěnka', url: path('oswis_org_oswis_calendar_web_admin_announcements', { eventSlug: eventSlug }) },
    { key: 'meals', label: 'Jídelníček', url: path('oswis_org_oswis_calendar_web_admin_meals', { eventSlug: eventSlug }) },
    { key: 'checkin', label: 'Check-in', url: path('oswis_org_oswis_calendar_web_admin_checkin_list', { eventSlug: eventSlug }) },
    { key: 'program', label: 'Program', url: path('oswis_org_oswis_calendar_web_admin_program_index', { eventSlug: eventSlug }) },
    { key: 'roster', label: 'Rozpis služeb', url: path('oswis_org_oswis_calendar_web_admin_service_roster', { eventSlug: eventSlug }) },
] %}
{# Přepínač ročníku a turnusů. Dřív tu byl jen NÁZEV akce, takže přepnout se na druhý turnus
   znamenalo vrátit se do Akcí a projít výběrem znovu; a na ročníku (který sám žádné přihlášky nemá)
   končily podstránky s nulou bez vysvětlení. Zůstane na TÉŽE stránce, jen pro jinou akci. #}
{% set _prepinac = oswis_prepinac_akci(eventSlug) %}
{% if _prepinac|length > 1 %}
    <form method="get" class="oa-event-switch" action="">
        <label class="oa-event-switch__label" for="oa-event-switch">Akce</label>
        <select class="form-select form-select-sm" id="oa-event-switch" name="eventSlug"
                data-oa-event-switch aria-label="Přepnout ročník nebo turnus">
            {% for volba in _prepinac %}
                <option value="{{ path(app.request.attributes.get('_route'), (app.request.attributes.get('_route_params')|default({}))|merge({ eventSlug: volba.slug })) }}"
                        {{- volba.current ? ' selected' : '' }}>{{ volba.label }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-primary">Přepnout</button></noscript>
    </form>
    <script>
        (function () {
            var vyber = document.querySelector('[data-oa-event-switch]');
            if (!vyber) { return; }
            vyber.addEventListener('change', function () {
                if (vyber.value) { window.location.href = vyber.value; }
            });
        })();
    </script>
{% endif %}
<twig:OswisOrgOswisCore:Admin:Subnav :items="_items" :current="current|default(null)" :label="_prepinac|length > 1 ? null : eventName|default(null)" ariaLabel="Podmenu turnusu" />
