{# Base print layout for program-module outputs (STOPA 1.3). DejaVu Sans for Czech
   diacritics (mPDF UTF-8), table basics, page-break safety, brand blue #006FAD.
   Branded header/footer (logo + time + page numbers) come from ExportService —
   do NOT repeat them here. Concrete templates `{% extends %}` this and fill `content`.
   mPDF limits: CSS only inline in <style>, no border-radius inside table cells. #}
<style>
    * { font-family: 'DejaVu Sans', sans-serif; }
    body { font-size: 10pt; color: #222; }
    h1 { font-size: 15pt; color: #006FAD; margin: 0 0 6pt; }
    h2 { font-size: 12pt; color: #006FAD; margin: 10pt 0 4pt; border-bottom: 0.6pt solid #006FAD; padding-bottom: 2pt; }
    h3 { font-size: 10.5pt; margin: 6pt 0 2pt; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; vertical-align: top; padding: 2pt 4pt; border-bottom: 0.4pt solid #ccc; }
    th { background: #eef5fa; font-size: 9pt; }
    tr, .row, .block, .day { page-break-inside: avoid; }
    .muted { color: #777; }
    .note { font-style: italic; color: #555; font-size: 9pt; }
    .price, .time { white-space: nowrap; }
    .strong { font-weight: bold; }
    .chip { display: inline-block; padding: 1pt 5pt; border: 0.4pt solid #999; font-size: 8.5pt; }
    {% block style %}{% endblock %}
</style>
{% block content %}{% endblock %}
