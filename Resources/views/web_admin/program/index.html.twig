{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{# Editor programu — JEDEN DEN NA OBRAZOVCE.

   ⚠️ Do 27. 8. 2026 tahle stránka vypsala VŠECHNY dny naráz: při 112 aktivitách na turnus to byla
   tabulka přes deset obrazovek, každý řádek s pěti tlačítky, a nad tím lišta s jedenácti dalšími.
   Uživatel to shrnul jako „strašně složité, roztahané, nepřehledné" — a měl pravdu, problém nebyl
   ve vzhledu, ale v tom, že obrazovka neměla jednu úlohu.

   Teď má: **spravovat program jednoho dne**. Den se vybírá dlaždicemi nahoře (`?den=RRRR-MM-DD`),
   dole je jen jeho tabulka. Všechno ostatní — bloky, dny, sekce, série, týmy a sedm tiskových
   výstupů — je pořád tady, ale schované v „Další nástroje a tisk"; nic se nemazalo, jen se to
   přestalo cpát na první pohled.

   Data: WebAdminProgramController::index (ProgramDataService). #}

{% block body_content %}
    <div class="container" style="padding: 1rem;">
        {% include '@OswisOrgOswisCalendar/web_admin/parts/event-subnav.html.twig'
            with { eventSlug: eventSlug, eventName: (event is defined ? (event.shortName|default(event.name|default(''))) : ''), current: 'program' } only %}
        {% set dayCount = tree|filter(row => row.day is not null)|length %}
        {% set activityCount = 0 %}
        {% for row in tree %}{% set activityCount = activityCount + row.activities|length %}{% endfor %}
        <twig:Admin:PageHeader :title="'Program — ' ~ (event.name ?? eventSlug)">
            <span class="badge text-bg-primary" style="font-size: .95rem;">{{ dayCount }} dní · {{ activityCount }} aktivit</span>
        </twig:Admin:PageHeader>

        <div class="row" style="margin-top: .5rem;">
            <div class="col">
                {% if event.isProgramReleased %}
                    <div class="alert alert-success" style="display: flex; align-items: center; gap: 1rem; padding: .45rem 1rem; margin: 0;">
                        <span><span class="badge text-bg-success">ZVEŘEJNĚNO</span> Program vidí účastníci v aplikaci{% if event.programReleasedAt %} (od {{ event.programReleasedAt|date('j. n. Y H:i') }}){% endif %}.</span>
                        <form method="post" style="margin: 0 0 0 auto;"
                              action="{{ path('oswis_org_oswis_calendar_web_admin_program_release', {eventSlug: eventSlug}) }}"
                              onsubmit="return confirm('Skrýt program účastníkům?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('program_release_' ~ event.id) }}">
                            {# Ne oranžový obrys: kontrast 2,01, a tady navíc na zeleném podkladu hlášky. #}
                            <button type="submit" class="btn btn-sm btn-outline-primary">Skrýt program</button>
                        </form>
                    </div>
                {% else %}
                    <div class="alert alert-warning" style="display: flex; align-items: center; gap: 1rem; padding: .45rem 1rem; margin: 0;">
                        <span><span class="badge text-bg-warning">SKRYTO</span> Program se staví — účastníci ho v aplikaci nevidí. Zveřejni ho, až bude hotový a zkontrolovaný.</span>
                        <form method="post" style="margin: 0 0 0 auto;"
                              action="{{ path('oswis_org_oswis_calendar_web_admin_program_release', {eventSlug: eventSlug}) }}"
                              onsubmit="return confirm('Zveřejnit program všem účastníkům turnusu?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('program_release_' ~ event.id) }}">
                            <button type="submit" class="btn btn-sm btn-success">Zveřejnit program</button>
                        </form>
                    </div>
                {% endif %}

                {# Kontrolní seznam k bráně zveřejnění. Brána sama říká „zveřejni, až bude
                   zkontrolovaný" — tohle je to, s čím se dá zkontrolovat. Ukazuje se i po
                   zveřejnění: vada v programu, který účastníci UŽ vidí, je naléhavější, ne míň. #}
                {% if kontrola|default([])|length > 0 %}
                    <div class="alert alert-warning" style="margin: .75rem 0 0; padding: .55rem 1rem;">
                        {# Nadpis se musí řídit stavem brány. Po zveřejnění tu stálo „Před zveřejněním
                           zkontroluj…" přímo pod zeleným pruhem „ZVEŘEJNĚNO" — dvě protichůdné věty nad
                           sebou. Seznam se ukazuje schválně i po zveřejnění (viz komentář výš), takže
                           se mění text, ne podmínka. #}
                        <strong>{{ event.isProgramReleased ? 'Zkontroluj' : 'Před zveřejněním zkontroluj' }} {{ kontrola|length }}
                            {{ kontrola|length == 1 ? 'aktivitu' : (kontrola|length < 5 ? 'aktivity' : 'aktivit') }}{% if event.isProgramReleased %} — účastníci program už vidí{% endif %}:</strong>
                        <ul style="margin: .35rem 0 0; padding-left: 1.2rem;">
                            {% for nalez in kontrola %}
                                <li style="font-size: .9rem;">
                                    {% if nalez.id %}
                                        {# Podtržení schválně: jinde v adminu stojí odkaz sám v buňce („upravit"),
                                           takže je poznat z pozice — tady je UVNITŘ VĚTY a od okolního textu ho dělí
                                           jen barva (změřeno 1,66:1, tedy pod 3:1 z WCAG 1.4.1). Barvoslepý by ho
                                           bez podtržení nerozeznal. Globální konvenci odkazů to nemění. #}
                                        <a style="text-decoration: underline;"
                                           href="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_edit', {eventSlug: eventSlug, activityId: nalez.id}) }}">{{ nalez.aktivita }}</a>
                                    {% else %}
                                        {{ nalez.aktivita }}
                                    {% endif %}
                                    — {{ nalez.problem }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Jediná akce, kterou tým dělá denně, zůstává na očích. Zbytek (bloky, dny, sekce,
           série, týmy, PDF) je pořád dostupný, ale je schovaný — na obrazovce jich bylo jedenáct
           a mezi nimi se ta jedna podstatná ztrácela. #}
        <div class="row mt-3">
            <div class="col d-flex flex-wrap gap-3 align-items-center">
                <a class="btn btn-primary"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_new', {eventSlug: eventSlug}) }}">+ Přidat aktivitu</a>
                <details class="oa-nastroje">
                    <summary>Další nástroje a tisk</summary>
                    <div class="oa-nastroje__obsah">
                        <twig:Admin:Toolbar label="Vytvořit:">
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_block_new', {eventSlug: eventSlug}) }}"
                               title="Nadřazený bod programu pro rotaci / sérii (např. dopolední rotace stanovišť)">+ Blok</a>
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_day_new', {eventSlug: eventSlug}) }}">+ Den</a>
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_section_new', {eventSlug: eventSlug}) }}">+ Sekce</a>
                        </twig:Admin:Toolbar>
                        <twig:Admin:Toolbar label="Nástroje:">
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_service_roster', {eventSlug: eventSlug}) }}">Rozpis služeb</a>
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_teams', {eventSlug: eventSlug}) }}">Týmy</a>
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_series', {eventSlug: eventSlug}) }}">Série</a>
                        </twig:Admin:Toolbar>
                        <twig:Admin:Toolbar label="Tisk (PDF):">
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_instructor', {eventSlug: eventSlug}) }}">Instruktorský</a>
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_roster', {eventSlug: eventSlug}) }}">Služby</a>
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_team', {eventSlug: eventSlug}) }}">Tým</a>
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_full', {eventSlug: eventSlug}) }}">Celý program</a>
                        </twig:Admin:Toolbar>
                    </div>
                </details>
            </div>
        </div>

        {% if activityCount == 0 %}
            <div class="row" style="margin-top: 1.5rem;">
                <div class="col">
                    <div class="alert alert-info" style="max-width: 46rem;">
                        Program tohoto turnusu zatím nemá žádné aktivity. Začni tlačítkem
                        <strong>„+ Přidat aktivitu"</strong> (jednotlivý bod programu) nebo
                        <strong>„+ Vytvořit blok"</strong> (rotace / série s podakcemi).
                    </div>
                </div>
            </div>
        {% endif %}

        {#
          Výběr dne. Klíč dne je datum (`RRRR-MM-DD`), nezařazené aktivity mají klíč `mimo`.
          Výchozí den: dnešek, pokud turnus zrovna běží, jinak první den s aktivitami — ať tým
          po otevření vidí to, co zrovna řeší, a nemusí klikat.
        #}
        {% set dnesek = "now"|date("Y-m-d") %}
        {% set klice = [] %}
        {% for row in tree %}{% set klice = klice|merge([row.day ? row.day.date : "mimo"]) %}{% endfor %}
        {% set zvoleny = app.request.query.get("den") %}
        {# `??` tu nejde použít — Twig ho překládá na test `defined`, který funguje jen nad
           prostou proměnnou, ne nad výsledkem filtru. Proto větvení. #}
        {% if zvoleny not in klice %}
            {% set sDatem = klice|filter(k => k != "mimo") %}
            {% if dnesek in klice %}
                {% set zvoleny = dnesek %}
            {% elseif sDatem|length > 0 %}
                {% set zvoleny = sDatem|first %}
            {% else %}
                {% set zvoleny = klice|length > 0 ? klice|first : null %}
            {% endif %}
        {% endif %}

        {#
          Výběr dne. ⚠️ ZÁMĚRNĚ to nejsou dlaždice: první pokus (27. 8. 2026) je okopíroval
          z cizí aplikace a na stránce, kde je jinak tabulka s modrou hlavičkou, působily jako
          nalepený cizí prvek — uživatel to hned odmítl. Stránka má vlastní slovník (odkazy,
          tučné zvýraznění aktivního), tak se používá on. Nový vizuální vzor se sem netahá.
        #}
        {% if klice|length > 1 %}
            {% set dny = ["pondělí", "úterý", "středa", "čtvrtek", "pátek", "sobota", "neděle"] %}
            <p class="oa-dny">
                {% for row in tree %}
                    {% set klic = row.day ? row.day.date : "mimo" %}
                    {% if klic == zvoleny %}
                        <strong>{% if row.day %}{{ dny[(row.day.date|date("N")) - 1] }} {{ row.day.date|date("j. n.") }}{% else %}mimo dny{% endif %}
                            ({{ row.activities|length }})</strong>
                    {% else %}
                        <a href="{{ path("oswis_org_oswis_calendar_web_admin_program_index", {eventSlug: eventSlug}) }}?den={{ klic }}">{% if row.day %}{{ dny[(row.day.date|date("N")) - 1] }} {{ row.day.date|date("j. n.") }}{% else %}mimo dny{% endif %}
                            ({{ row.activities|length }})</a>
                    {% endif %}
                    {%- if not loop.last %} · {% endif %}
                {% endfor %}
            </p>
        {% endif %}

        {#
          „Místo" a „Obsazení" se z importu nevyplňují, takže na 112 aktivitách 1. turnusu
          to byly dva sloupce plné pomlček — čtvrtina šířky tabulky bez jediného údaje.
          Sloupec se schová, jen když je prázdný v CELÉM programu; jakmile má hodnotu byť
          jediná aktivita, vrátí se. Schválně ne po dnech — sloupec, který se mezi dny
          objevuje a mizí, se čte hůř než pomlčky.
          Počítá se přes `reduce`, protože `{% set %}` uvnitř `{% for %}` v Twigu za smyčku
          nepřeteče — na to už tahle šablona jednou najela (viz komentář u výběru dne).
        #}
        {% set maMisto = tree|reduce((acc, row) => acc + (row.activities|filter(a => a.placeText)|length), 0) > 0 %}
        {% set maObsazeni = tree|reduce((acc, row) => acc + (row.activities|filter(a => a.staff|length > 0)|length), 0) > 0 %}

        {% for row in tree %}
            {% set klic = row.day ? row.day.date : "mimo" %}
            {% if klic == zvoleny %}
            <div class="row" style="margin-top: 1.25rem;">
                <div class="col">
                    <h3 style="margin: 0 0 .4rem; border-bottom: 2px solid #006fad; padding-bottom: .2rem; display: flex; align-items: baseline; gap: .5rem;">
                        {% if row.day %}
                            {% set dnyN = ['pondělí', 'úterý', 'středa', 'čtvrtek', 'pátek', 'sobota', 'neděle'] %}
                            <span>{{ row.day.name ?? 'Den' }}
                                {# Datum lidsky, ne syrové `2026-09-01` z databáze. #}
                                <small style="color: #6c757d; font-weight: normal;">{{ dnyN[(row.day.date|date('N')) - 1] }} {{ row.day.date|date('j. n. Y') }}</small></span>
                            <span style="margin-left: auto; font-size: .8rem; font-weight: normal; display: inline-flex; gap: .4rem; align-items: baseline;">
                                {# Program dne v PDF. Dřív osiřelý výstup (program_day) — renderoval se
                                   a byl krytý testem, ale odnikud na něj nevedl odkaz. #}
                                <a href="{{ path('oswis_org_oswis_calendar_web_admin_program_day', {eventSlug: eventSlug, dayId: row.day.id}) }}"
                                   title="Program tohoto dne v PDF">PDF</a>
                                <a href="{{ path('oswis_org_oswis_calendar_web_admin_program_day_edit', {eventSlug: eventSlug, dayId: row.day.id}) }}">upravit</a>
                                <form method="post" style="display: inline; margin: 0;"
                                      action="{{ path('oswis_org_oswis_calendar_web_admin_program_day_delete', {eventSlug: eventSlug, dayId: row.day.id}) }}"
                                      onsubmit="return confirm('Smazat den „{{ row.day.name ?? row.day.date }}"? Aktivity zůstanou.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('program_day_delete_' ~ row.day.id) }}">
                                    <button type="submit" style="border: 0; background: none; color: #b02a37; cursor: pointer; padding: 0; font-size: .8rem;">smazat</button>
                                </form>
                            </span>
                        {% else %}
                            <span>Nezařazené aktivity <small style="color: #6c757d; font-weight: normal;">(mimo dny programu)</small></span>
                        {% endif %}
                    </h3>
                    {# Aktivita BEZ ČASU je past: tady ji vidíš, ale v aplikaci ji účastník NEUVIDÍ —
                       účastnický program se skládá podle časů aktivit, a co čas nemá, to se přeskočí.
                       Čas přitom není povinný (formulář `required => false`), takže se to dá uložit
                       omylem. Varování se ukazuje jen tehdy, když se to opravdu stalo. #}
                    {% if not row.day %}
                        {# Obě sdělení platí NEZÁVISLE na sobě: „mimo dny“ je definice téhle skupiny
                           (datum aktivity neodpovídá žádnému dni), chybějící čas je další vada navrch.
                           Dřív byly ve větvích if/else, takže když nějaká aktivita neměla čas, tým se
                           o chybějícím dni vůbec nedozvěděl. #}
                        <p class="text-muted" style="margin: 0 0 .5rem; font-size: .9rem;">
                            Datum těchto aktivit neodpovídá žádnému dni programu. V aplikaci se
                            účastníkům zobrazí normálně, v <strong>tiskových výstupech</strong> ale
                            vypadnou z členění po dnech a vytisknou se až na konci — přidej
                            odpovídající den tlačítkem „+ Den“.
                        </p>
                        {% set bezCasu = row.activities|filter(a => not a.start)|length %}
                        {% if bezCasu > 0 %}
                            <p class="alert alert-warning" style="margin: 0 0 .5rem; padding: .4rem .6rem; font-size: .9rem;">
                                Navíc <strong>{{ bezCasu }}</strong>
                                {{ bezCasu == 1 ? 'aktivita nemá čas' : (bezCasu < 5 ? 'aktivity nemají čas' : 'aktivit nemá čas') }}
                                — <strong>ty účastníci v aplikaci neuvidí vůbec</strong>. Doplň čas, ať se program zobrazí celý.
                            </p>
                        {% endif %}
                    {% endif %}
                    <table class="list" style="margin: 0;">
                        <thead>
                            <tr>
                                <th style="width: 6rem;">Čas</th>
                                <th>Aktivita</th>
                                {% if maMisto %}<th>Místo</th>{% endif %}
                                <th>Kategorie</th>
                                {% if maObsazeni %}<th>Obsazení</th>{% endif %}
                                <th style="width: 4rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for a in row.activities %}
                                <tr>
                                    <td style="white-space: nowrap;">{{ a.start ?? '—' }}{% if a.end %}–{{ a.end }}{% endif %}</td>
                                    <td>
                                        {% if a.highlight %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}
                                        {% if a.seriesRoman %} {{ a.seriesRoman }}{% endif %}
                                        {% if a.isBlock %}<span class="badge text-bg-secondary" style="margin-left: .3rem;">blok</span>{% endif %}
                                        {% if a.price %}<span class="badge text-bg-warning" style="margin-left: .3rem;">{{ a.price }} Kč</span>{% endif %}
                                        {% if a.targetGroup %}
                                            {# Barvu textu počítat — pozadí je barva skupiny z dat, může být i světlá. #}
                                            {% set groupColor = a.targetGroup.color ?? '#6c757d' %}
                                            <span class="badge" style="margin-left: .3rem; background: {{ groupColor }}; color: {{ groupColor|contrast_color }};">{{ a.targetGroup.name }}</span>
                                        {% endif %}
                                        {% if not a.publicInApp %}<span class="badge text-bg-light" style="margin-left: .3rem;" title="Neveřejné (interní)">interní</span>{% endif %}
                                        {% for sub in a.subActivities %}
                                            <div style="margin-left: 1rem; color: #444; font-size: .9rem;">
                                                ↳ {{ sub.start ?? '' }} {{ sub.name }}
                                                {% if sub.targetGroup %}{% set subGroupColor = sub.targetGroup.color ?? '#6c757d' %}<span class="badge" style="background: {{ subGroupColor }}; color: {{ subGroupColor|contrast_color }};">{{ sub.targetGroup.name }}</span>{% endif %}
                                            </div>
                                        {% endfor %}
                                    </td>
                                    {% if maMisto %}<td style="color: #444;">{{ a.placeText ?? '—' }}</td>{% endif %}
                                    <td>{% if a.category %}<span class="badge text-bg-info">{{ a.category }}</span>{% else %}—{% endif %}</td>
                                    {% if maObsazeni %}<td style="font-size: .9rem;">
                                        {% for s in a.staff %}
                                            {{ s.name }}{% if s.roleLabel %} <span style="color: #6c757d;">({{ s.roleLabel }})</span>{% endif %}{% if not loop.last %}, {% endif %}
                                        {% else %}<span style="color: #adb5bd;">—</span>{% endfor %}
                                    </td>{% endif %}
                                    <td style="white-space: nowrap;">
                                        {% if a.id %}
                                            {% if a.isBlock %}
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_new', {eventSlug: eventSlug, block: a.id}) }}"
                                                   title="Přidat podakci (rotační slot) do tohoto bloku">+ podakce</a>
                                            {% endif %}
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_edit', {eventSlug: eventSlug, activityId: a.id}) }}">upravit</a>
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_staff', {eventSlug: eventSlug, activityId: a.id}) }}">obsazení</a>
                                            {# Duplikovat a smazat jsou VEDLEJŠÍ úkony — jako textové odkazy, ne čtvrté
                                               a páté tlačítko v řádku. Při deseti aktivitách na den to bylo padesát
                                               stejně vypadajících tlačítek na obrazovce. Stejný tvar používá i řádek
                                               dne nad tabulkou, takže to nezavádí nový vzor. #}
                                            <span class="oa-radek-akce">
                                                <form method="post"
                                                      action="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_duplicate', {eventSlug: eventSlug, activityId: a.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('program_activity_duplicate_' ~ a.id) }}">
                                                    <button type="submit">duplikovat</button>
                                                </form>
                                                <form method="post"
                                                      action="{{ path('oswis_org_oswis_calendar_web_admin_program_activity_delete', {eventSlug: eventSlug, activityId: a.id}) }}"
                                                      onsubmit="return confirm({% if a.subActivities|length > 0 %}'Smazat blok „{{ a.name|e('js') }}" i s {{ a.subActivities|length }} podakcemi? (skryje se z programu)'{% else %}'Smazat „{{ a.name|e('js') }}"? (skryje se z programu)'{% endif %});">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('program_activity_delete_' ~ a.id) }}">
                                                    <button type="submit" class="je-smazani">smazat</button>
                                                </form>
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
        {% endfor %}

        {% if sections|length > 0 %}
            <div class="row" style="margin-top: 1.5rem;">
                <div class="col">
                    <h3 style="margin: 0 0 .4rem; border-bottom: 2px solid #006fad; padding-bottom: .2rem;">Sekce (info / patička)</h3>
                    <ul class="list-group" style="max-width: 46rem;">
                        {% for s in sections %}
                            <li class="list-group-item" style="display: flex; align-items: center; gap: .5rem;">
                                <strong>{{ s.name ?? '—' }}</strong>
                                {% if s.publicInApp %}<span class="badge text-bg-success">veřejné</span>{% else %}<span class="badge text-bg-light">interní</span>{% endif %}
                                <span style="color: #adb5bd; margin-left: auto;">priorita {{ s.priority ?? 0 }}</span>
                                {% if s.id %}
                                    <a style="font-size: .8rem;" href="{{ path('oswis_org_oswis_calendar_web_admin_program_section_edit', {eventSlug: eventSlug, sectionId: s.id}) }}">upravit</a>
                                    <form method="post" style="display: inline; margin: 0;"
                                          action="{{ path('oswis_org_oswis_calendar_web_admin_program_section_delete', {eventSlug: eventSlug, sectionId: s.id}) }}"
                                          onsubmit="return confirm('Smazat sekci „{{ s.name }}"?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('program_section_delete_' ~ s.id) }}">
                                        <button type="submit" style="border: 0; background: none; color: #b02a37; cursor: pointer; padding: 0; font-size: .8rem;">smazat</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
