{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{% block html_title %}{{ page_title }}{% endblock %}

{% block body_content %}
    <main class="container">
        {% include '@OswisOrgOswisCalendar/web_admin/parts/communication-subnav.html.twig' with { current: 'campaigns' } only %}
        <h2>{{ pageTitle }}</h2>
        <p>
            <a class="btn btn-sm btn-link" href="{{ path('oswis_org_oswis_calendar_web_admin_mail_template_history', { id: template.id }) }}">← Historie verzí</a>
            · <a class="btn btn-sm btn-link" href="{{ path('oswis_org_oswis_calendar_web_admin_mail_template_edit', { id: template.id }) }}">Úprava šablony</a>
        </p>
        <p>
            Uloženo {{ version.createdAt|date('j. n. Y H:i', 'Europe/Prague') }}{% if version.author %} ({{ version.author }}){% endif %}{% if version.note %} — „{{ version.note }}"{% endif %}.
            {% if jePosledni %}<span class="badge text-bg-primary">aktuální verze</span>{% endif %}
        </p>

        <h3 class="h5">{{ previous ? 'Změny proti verzi ' ~ previous.number : 'Výchozí verze' }}</h3>
        {% if previous %}
            {% if zmenyPoli is not empty %}
                <table class="list mb-3" data-zmeny-poli>
                    <thead><tr><th>Pole</th><th>Předtím</th><th>Nově</th></tr></thead>
                    <tbody>
                        {% for z in zmenyPoli %}
                            <tr><td>{{ z.pole }}</td><td>{{ z.pred|default('—') }}</td><td>{{ z.po|default('—') }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
            {% include '@OswisOrgOswisCalendar/web_admin/mail_config/_rozdil.html.twig' with { rozdil: rozdil } only %}
        {% else %}
            <p class="text-muted small">Stav šablony v okamžiku, kdy se historie začala vést.</p>
        {% endif %}

        <details class="mt-3">
            <summary style="cursor:pointer;">Celý text této verze</summary>
            <dl class="mt-2 mb-2 small">
                <dt>Předmět</dt><dd>{{ version.subject|default('—') }}</dd>
                <dt>Vychází z</dt><dd>{{ version.parent|default('—') }}</dd>
            </dl>
            <pre class="border rounded p-2 small" style="white-space: pre-wrap; max-height: 32rem; overflow: auto;">{{ version.textValue }}</pre>
        </details>

        {% if not jePosledni %}
            <form method="post" action="{{ path('oswis_org_oswis_calendar_web_admin_mail_template_restore', { id: template.id, number: version.number }) }}" class="mt-3"
                  onsubmit="return confirm('Obnovit šablonu do stavu verze {{ version.number }}? Uloží se jako nová verze, současný stav zůstane v historii.');">
                <input type="hidden" name="_token" value="{{ csrf_token('template_restore_' ~ template.id ~ '_' ~ version.number) }}">
                <input type="hidden" name="revize" value="{{ revize }}">
                <button type="submit" class="btn btn-outline-primary">Obnovit tuto verzi</button>
            </form>
        {% endif %}
    </main>
{% endblock %}
