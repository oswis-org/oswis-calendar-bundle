{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{% block html_title %}{{ page_title }}{% endblock %}

{% block body_content %}
    <main class="container">
        {% include '@OswisOrgOswisCalendar/web_admin/parts/communication-subnav.html.twig' with { current: 'campaigns' } only %}
        <h2>{{ pageTitle }}</h2>
        <p>
            <a class="btn btn-sm btn-link"
               href="{{ path('oswis_org_oswis_calendar_web_admin_mail_config') }}">← Zpět na konfiguraci e-mailů</a>
            {% if kind == 'template' and entity.id %}
                · <a class="btn btn-sm btn-link" href="{{ path('oswis_org_oswis_calendar_web_admin_mail_template_history', { id: entity.id }) }}">Historie verzí ({{ pocetVerzi|default(0) }})</a>
            {% endif %}
        </p>
        {# Souběh (dávka 4): šablonu mezitím uložil někdo jiný — nic se nepřepsalo; autor vidí rozdíl a další „Uložit"
           už vychází z aktuální revize (přepíše vědomě). #}
        {% if konflikt|default(null) %}
            <div class="alert alert-warning" role="alert" data-konflikt>
                <strong>Šablonu mezitím uložil{{ konflikt.kdo ? ' ' ~ konflikt.kdo : ' někdo jiný' }}{{ konflikt.kdy ? ' (' ~ konflikt.kdy|date('j. n. H:i', 'Europe/Prague') ~ ')' : '' }}.</strong>
                Tvoje úpravy se neuložily — jsou pořád ve formuláři. Níže je, čím se tvůj text liší od uloženého
                (červeně jen v uloženém, zeleně jen v tvém). Když znovu klikneš na „Uložit", tvoje verze uložené změny přepíše.
                {% include '@OswisOrgOswisCalendar/web_admin/mail_config/_rozdil.html.twig' with { rozdil: konflikt.rozdil } only %}
            </div>
        {% endif %}
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {% if form.revize is defined %}
            {{ form_widget(form.revize, konflikt|default(null) ? { value: konflikt.revize } : {}) }}
        {% endif %}
        {# Editor textu dodává formulářový typ MailBodyType (motiv je registrovaný globálně),
           takže tady stačí běžné vykreslení formuláře — žádné vypisování polí po jednom
           ani ruční vkládání partialu. #}
        {{ form_widget(form) }}
        {{ form_end(form) }}

        {% if kind == 'group' and entity.filterExpression and (not form.vars.submitted or form.vars.valid) %}
            {# Filter sanity-check: the unified participant list evaluates the SAME expression language,
               so one click shows exactly who the group currently applies to (before enabling automail).
               Hidden after an invalid submit — the bound entity then holds the rejected expression and
               the link would just 400 on the list. #}
            <p style="margin-top: .75rem;">
                {% set listParams = entity.event
                    ? { expr: entity.filterExpression, eventSlug: entity.event.slug }
                    : { expr: entity.filterExpression } %}
                <a class="btn btn-sm btn-outline-secondary" target="_blank"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_participants_list', listParams) }}">
                    <twig:ux:icon name="tabler:users" class="oa-icon" /> Zobrazit účastníky odpovídající filtru v seznamu přihlášek
                </a>
            </p>
        {% endif %}

        {% if kind == 'group' and prijemci|default(null) %}
            {% include '@OswisOrgOswisCalendar/web_admin/mail_config/_prijemci.html.twig' with { group: entity, prijemci: prijemci } only %}
        {% endif %}
    </main>
{% endblock %}
