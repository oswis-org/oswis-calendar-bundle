{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{% block html_title %}
    {{ page_title|default(pageTitle|default('Účastník #' ~ participant.id ~ ' — ' ~ (participant.contact.name|default('?')))) }} :: ADMIN
{% endblock %}

{% set contact = participant is defined ? participant.contact : null %}
{% set event = participant.event(false)|default %}
{% set superEvent = event.superEvent|default %}
{% set isFullDetail = showFullDetail|default(false) %}
{% set paid = participant.paidPrice|default(0) %}
{% set total = participant.price|default(0) %}
{% set remaining = participant.remainingPrice|default(0) %}
{% set pct = total > 0 ? (paid / total * 100)|round : (paid > 0 ? 100 : 0) %}
{% if pct > 100 %}{% set pct = 100 %}{% endif %}
{% if pct < 0 %}{% set pct = 0 %}{% endif %}
{% set acctActive = contact.appUser|default and contact.appUser.activated|default %}

{% block body_content %}
    <div class="container">
        {# Hlavička — vzor jako web_admin/event.html.twig (h2 + odznaky) #}
        <div class="row">
            <div class="col" style="display:flex; align-items:center; gap:.6rem; flex-wrap:wrap;">
                <h2 style="margin:0;">
                    {{ contact.name|default('Účastník #' ~ participant.id) }}
                    <span class="badge text-bg-primary" style="font-size:.5em; vertical-align:middle;">#{{ participant.id }}</span>
                    {% if participant.deletedAt|default %}
                        <span class="badge text-bg-danger" style="font-size:.5em; vertical-align:middle;">SMAZÁNO {{ participant.deletedAt|date('j. n. Y') }}</span>
                    {% endif %}
                    {% if acctActive %}
                        <span class="badge text-bg-success" style="font-size:.5em; vertical-align:middle;">účet aktivován</span>
                    {% elseif contact.email|default %}
                        <span class="badge text-bg-warning" style="font-size:.5em; vertical-align:middle;">účet neaktivován</span>
                    {% endif %}
                </h2>
            </div>
        </div>
        <p class="text-muted" style="margin:.15rem 0 1rem;">
            {{ event.name|default('—') }}{% if superEvent %} · {{ superEvent.name }}{% endif %}
            · vytvořeno {{ participant.createdAt|date('j. n. Y H:i', 'Europe/Prague')|default('—') }}
            {% if total > 0 and remaining <= 0 %}
                · <span class="text-success">zaplaceno</span>
            {% else %}
                · <span class="text-danger">zbývá {{ remaining }}&nbsp;Kč</span>
            {% endif %}
        </p>

        {# Akce: kontaktní + admin v jednom zalamovacím řádku #}
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; margin-bottom:1.5rem;">
            {% include '@OswisOrgOswisCalendar/web_admin/communication/_quick_actions.html.twig' with { participant: participant } only %}
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-sm btn-outline-primary"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_participant_compose_mail', { participantId: participant.id }) }}"
                   title="Napsat a odeslat ad-hoc e-mail účastníkovi"><twig:ux:icon name="tabler:pencil" class="oa-icon" /> Nová zpráva</a>
                <a class="btn btn-sm btn-outline-primary"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_participant_manual_note', { participantId: participant.id }) }}"
                   title="Zaznamenat telefonát, SMS, chat nebo jiný kontakt"><twig:ux:icon name="tabler:notes" class="oa-icon" /> Záznam komunikace</a>
                <a class="btn btn-sm btn-outline-primary"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_imap_unmatched') }}"
                   title="Nezařazené příchozí / odchozí e-maily z IMAP"><twig:ux:icon name="tabler:inbox" class="oa-icon" /> Nezařazené e-maily</a>
                <form method="post" action="{{ path('oswis_org_oswis_calendar_web_admin_imap_refresh') }}" style="display:inline-block; margin:0;" title="Stáhnout nové e-maily z IMAP serveru">
                    <input type="hidden" name="_token" value="{{ csrf_token('imap_refresh') }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary"><twig:ux:icon name="tabler:refresh" class="oa-icon" /> Stáhnout z IMAP</button>
                </form>
                {% if contact and contact.email|default and not acctActive %}
                    <form method="post"
                          action="{{ path('oswis_org_oswis_calendar_web_admin_participant_resend_activation', { participantId: participant.id }) }}"
                          style="display:inline-block; margin:0;"
                          onsubmit="return confirm('Znovu odeslat aktivační e-mail účastníkovi #{{ participant.id }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('participant_resend_activation_' ~ participant.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><twig:ux:icon name="tabler:refresh" class="oa-icon" /> Aktivační e-mail</button>
                    </form>
                {% endif %}
                {# Shrnutí = pokyny k platbě + QR. Renderuje se z aktuálních dat, takže ho lze poslat
                   kdykoliv — i když v evidenci žádné shrnutí není (přihláška ověřená účtem, který už
                   byl aktivovaný z dřívějška, ho historicky nedostala). #}
                {% if contact and contact.email|default %}
                    <form method="post"
                          action="{{ path('oswis_org_oswis_calendar_web_admin_participant_send_summary', { participantId: participant.id }) }}"
                          style="display:inline-block; margin:0;"
                          onsubmit="return confirm('Odeslat účastníkovi #{{ participant.id }} shrnutí přihlášky s pokyny k platbě?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('participant_send_summary_' ~ participant.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-primary"
                                title="Poslat shrnutí přihlášky s pokyny k platbě a QR kódem (podle aktuálních dat)"><twig:ux:icon name="tabler:receipt" class="oa-icon" /> Shrnutí přihlášky</button>
                    </form>
                {% endif %}
                {% if participant.deletedAt|default %}
                    <form method="post"
                          action="{{ path('oswis_org_oswis_calendar_web_admin_participant_restore', { participantId: participant.id }) }}"
                          style="display:inline-block; margin:0;"
                          onsubmit="return confirm('Opravdu obnovit účastníka #{{ participant.id }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('participant_restore_' ~ participant.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-success"><twig:ux:icon name="tabler:refresh" class="oa-icon" /> Obnovit</button>
                    </form>
                {% else %}
                    {#
                      Zrušení přihlášky šlo dosud jen ze seznamu a ze stránky duplicit. Na detailu —
                      tedy tam, kde se člověk rozhoduje, protože právě prošel platby, příznaky a poštu —
                      tlačítko chybělo a bylo nutné se vracet do seznamu a hledat řádek znovu.

                      Potvrzení hlásí zaplacenou částku, pokud nějaká je: zrušit přihlášku s penězi
                      znamená, že peníze zůstanou viset na zrušené přihlášce a je potřeba je nejdřív
                      převést jinam nebo vrátit.
                    #}
                    <form method="post"
                          action="{{ path('oswis_org_oswis_calendar_web_admin_participant_delete', { participantId: participant.id }) }}"
                          style="display:inline-block; margin:0;"
                          onsubmit="return confirm('Opravdu zrušit přihlášku #{{ participant.id }}{% if paid > 0 %} — POZOR, visí na ní {{ paid|number_format(0, ',', ' ') }} Kč{% endif %}?\n\nÚčastníkovi se odešle e-mail o zrušení přihlášky.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('participant_delete_' ~ participant.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                title="Zrušit přihlášku (měkké smazání — jde obnovit). Účastníkovi odejde e-mail o zrušení."><twig:ux:icon name="tabler:trash" class="oa-icon" /> Zrušit přihlášku</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>

        {% if not isFullDetail %}
            {# Legacy arrival / check-in screen still relies on the full e-mail summary include. #}
            {% include '@OswisOrgOswisCalendar/other/summary/participant-summary.html.twig' with {'isInternal': true} %}
        {% else %}
            <div class="row">
                {# Kontakt #}
                <div class="col-12 col-xl-6">
                    <h3>Kontakt</h3>
                    <table class="list">
                        <thead><tr><th>Položka</th><th>Hodnota</th></tr></thead>
                        <tbody><tr>
                            <td>Jméno</td>
                            <td><strong>{{ contact.name|default('—') }}</strong></td>
                        </tr></tbody>
                        <tbody><tr>
                            <td>Pohlaví
                                <div class="block small">automaticky dle jména, lze přepsat</div>
                            </td>
                            <td>
                                {% set g = contact.gender|default('unisex') %}
                                {% set override = contact.genderOverride|default %}
                                <strong>{{ g == 'male' ? 'Muž' : (g == 'female' ? 'Žena' : 'neurčeno') }}</strong>
                                <span class="small text-muted">({{ override ? 'ručně' : 'automaticky' }})</span>
                                <form method="post" style="display:inline-flex; gap:.25rem; margin-top:.25rem;"
                                      action="{{ path('oswis_org_oswis_calendar_web_admin_participant_set_gender', {participantId: participantId}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('participant_set_gender_' ~ participantId) }}">
                                    <select name="gender" class="form-select form-select-sm" style="width:auto;" title="Ruční override pohlaví">
                                        <option value="" {{ override ? '' : 'selected' }}>automaticky</option>
                                        <option value="male" {{ override == 'male' ? 'selected' : '' }}>Muž</option>
                                        <option value="female" {{ override == 'female' ? 'selected' : '' }}>Žena</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Uložit</button>
                                </form>
                            </td>
                        </tr></tbody>
                        <tbody><tr>
                            <td>E-mail</td>
                            <td>{% if contact.email|default %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% else %}—{% endif %}</td>
                        </tr></tbody>
                        <tbody><tr>
                            <td>Telefon</td>
                            <td>{% if contact.phone|default %}<a href="tel:{{ contact.phone }}">{{ contact.phone }}</a>{% else %}—{% endif %}</td>
                        </tr></tbody>
                        {# Oprava údajů kontaktu. Do 19. 8. 2026 nešlo ve web adminu opravit ani
                           překlep ve jméně — routa na editaci kontaktu prostě neexistovala, přestože
                           na těchhle polích visí rozesílání pošty i příjezdová evidence.
                           Schované v `<details>`, aby se detail nezahltil: běžně se čte, needituje. #}
                        <tbody><tr>
                            <td>Opravit údaje
                                <div class="block small">jméno, e-mail, telefon</div>
                            </td>
                            <td>
                                <details>
                                    <summary style="cursor:pointer; color:var(--oa-primary);">upravit</summary>
                                    <form method="post" style="margin-top:.5rem;"
                                          action="{{ path('oswis_org_oswis_calendar_web_admin_participant_edit_contact', {participantId: participantId}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('participant_edit_contact_' ~ participantId) }}">
                                        <label class="small" for="contactName-{{ participantId }}">Jméno</label>
                                        <input id="contactName-{{ participantId }}" type="text" name="contactName" maxlength="170"
                                               class="form-control form-control-sm" value="{{ contact.name|default('') }}">
                                        <label class="small" for="contactEmail-{{ participantId }}">E-mail</label>
                                        <input id="contactEmail-{{ participantId }}" type="email" name="contactEmail" maxlength="170"
                                               class="form-control form-control-sm" value="{{ contact.email|default('') }}">
                                        <label class="small" for="contactPhone-{{ participantId }}">Telefon</label>
                                        <input id="contactPhone-{{ participantId }}" type="tel" name="contactPhone" maxlength="60"
                                               class="form-control form-control-sm" value="{{ contact.phone|default('') }}">
                                        <div class="small text-muted" style="margin:.35rem 0;">
                                            Prázdné pole se neuloží — hodnota zůstane, jaká byla.
                                            {% if contact.appUser|default %}
                                                Účastník má uživatelský účet, takže se <strong>jméno i e-mail
                                                změní i tam</strong> (pošta chodí na adresu účtu).
                                                {% if contact.appUser.username|default and contact.appUser.username == contact.appUser.email|default %}
                                                    S e-mailem se změní i <strong>přihlašovací jméno</strong> — je zatím shodné s adresou.
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Uložit údaje</button>
                                    </form>
                                </details>
                            </td>
                        </tr></tbody>
                        <tbody><tr>
                            <td>Uživatelský účet</td>
                            <td>
                                {% if contact.appUser|default %}
                                    {{ contact.appUser.username|default(contact.appUser.email|default('—')) }}
                                    {% if acctActive %}
                                        <span class="badge text-bg-success">aktivován</span>
                                    {% else %}
                                        <span class="badge text-bg-warning">neaktivován</span>
                                    {% endif %}
                                {% else %}—{% endif %}
                            </td>
                        </tr></tbody>
                    </table>
                </div>

                {# Přihláška #}
                <div class="col-12 col-xl-6">
                    <h3>Přihláška</h3>
                    <table class="list">
                        <thead><tr><th>Položka</th><th>Hodnota</th></tr></thead>
                        <tbody><tr><td>ID přihlášky</td><td><strong>#{{ participant.id }}</strong></td></tr></tbody>
                        <tbody><tr><td>Vytvořeno</td><td>{{ participant.createdAt|date('j. n. Y H:i', 'Europe/Prague')|default('—') }}</td></tr></tbody>
                        <tbody><tr><td>Akce</td><td>{{ event.name|default('—') }}</td></tr></tbody>
                        {% if superEvent %}
                            <tbody><tr><td>Nadřazená akce</td><td>{{ superEvent.name }}</td></tr></tbody>
                        {% endif %}
                        <tbody><tr><td>Kategorie</td><td>{{ participant.participantCategory(false).name|default('—') }}</td></tr></tbody>
                        <tbody><tr><td>Var. symbol</td><td>{{ participant.variableSymbol|default('—') }}</td></tr></tbody>
                    </table>
                    {# Osobní itinerář účastníka. Dřív osiřelý výstup (program_itinerary): renderoval
                       se, byl krytý testem, ale odnikud na něj nevedl odkaz — dal se otevřít jen
                       ručně sestaveným URL. Patří sem, protože potřebuje konkrétního člověka. #}
                    {% if participant.event.slug|default %}
                        <div id="itinerar" style="margin-top: .5rem;">
                            <strong>Osobní itinerář</strong>
                            <span class="text-muted" style="font-size: .8rem;">(program tohoto účastníka k vytištění)</span>
                            <div style="margin-top: .25rem;">
                                <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener"
                                   href="{{ path('oswis_org_oswis_calendar_web_admin_program_itinerary', {eventSlug: participant.event.slug, participantId: participantId}) }}">PDF</a>
                            </div>
                        </div>
                    {% endif %}
                    {# Přesun jednotlivce. Dřív šlo přesunout jen přes hromadného průvodce, kde bylo
                       nutné vybrat zdrojovou akci a kategorii a najít člověka v seznamu — z jeho
                       vlastního detailu cesta nevedla. Aplikace to na detailu uměla, web-admin ne. #}
                    {% if moveOffers|default([])|length > 0 %}
                        <div id="presun" style="margin-top: .5rem;">
                            <strong>Přesun na jinou nabídku</strong>
                            <span class="text-muted" style="font-size: .8rem;">(jiný turnus téhož ročníku; účastníkovi odejde oznámení o změně přihlášky)</span>
                            <form method="post" style="margin-top: .25rem;"
                                  action="{{ path('oswis_org_oswis_calendar_web_admin_participant_move', {participantId: participantId}) }}"
                                  onsubmit="return confirm('Opravdu přesunout přihlášku #{{ participantId }} na vybranou nabídku? Účastníkovi odejde oznámení o změně.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('participant_move_' ~ participantId) }}">
                                <div style="display: flex; gap: .5rem; flex-wrap: wrap; align-items: flex-end;">
                                    <label style="font-size: .82rem;">Cílová nabídka<br>
                                        <select name="targetOfferId" class="form-select form-select-sm" style="width: auto;">
                                            {% for offer in moveOffers %}
                                                <option value="{{ offer.id }}"{{ participant.offer(false).id|default(0) == offer.id ? ' selected' : '' }}>
                                                    {{ offer.name }}{{ participant.offer(false).id|default(0) == offer.id ? ' — současná' : '' }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </label>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Přesunout</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}
                    <div id="partial-stay" style="margin-top: .5rem;">
                        <strong>Zkrácený pobyt</strong>
                        <span class="text-muted" style="font-size: .8rem;">(pozdější příjezd / dřívější odjezd — volný text, plní tým z e-mailu/poznámky)</span>
                        <form method="post" style="margin-top: .25rem;"
                              action="{{ path('oswis_org_oswis_calendar_web_admin_participant_partial_stay', {participantId: participantId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('participant_partial_stay_' ~ participantId) }}">
                            <div style="display: flex; gap: .5rem; flex-wrap: wrap; align-items: flex-end;">
                                <label style="font-size: .82rem;">Pozdější příjezd<br>
                                    <input type="text" name="plannedArrival" value="{{ participant.plannedArrival|default('') }}"
                                           placeholder="např. 2. 9. kolem 17:00" style="width: 12rem;">
                                </label>
                                <label style="font-size: .82rem;">Dřívější odjezd<br>
                                    <input type="text" name="plannedDeparture" value="{{ participant.plannedDeparture|default('') }}"
                                           placeholder="např. 4. 9. odpoledne" style="width: 12rem;">
                                </label>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Uložit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {# Platby #}
            <h3 id="platby">Platby</h3>
            <table class="list">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Typ</th>
                        <th class="text-center">Částka</th>
                        <th>Poznámka</th>
                        <th class="text-center">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in participant.payments|default([]) %}
                        <tr>
                            <td style="white-space:nowrap;">{{ payment.dateTime|date('j. n. Y', 'Europe/Prague')|default('—') }}</td>
                            <td>{{ payment.type|default('—') }}</td>
                            <td class="text-center {{ payment.numericValue > 0 ? 'text-success' : 'text-danger' }}" style="white-space:nowrap;">
                                <strong>{{ payment.numericValue > 0 ? '+' : '' }}{{ payment.numericValue|default(0) }}&nbsp;Kč</strong>
                            </td>
                            <td>
                                {{ payment.note|default }}
                                {% if payment.internalNote|default %}<div class="block small text-muted">{{ payment.internalNote }}</div>{% endif %}
                            </td>
                            <td class="text-center">
                                {% if is_granted('ROLE_ADMIN') and payment.id|default %}
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('oswis_org_oswis_calendar_web_admin_payment_edit', { id: payment.id }) }}">Upravit</a>
                                    {# Převod zálohy na jiného člověka — typicky když někdo nejede
                                       a jde za něj kamarád. Schované v `<details>`, ať to nejde
                                       udělat omylem; bankovní údaje platby se nemění. #}
                                    <details style="display:inline-block; text-align:left;">
                                        <summary style="cursor:pointer; color:var(--oa-primary); display:inline;">Převést</summary>
                                        <form method="post" style="margin-top:.35rem;"
                                              action="{{ path('oswis_org_oswis_calendar_web_admin_payment_transfer', { paymentId: payment.id }) }}"
                                              onsubmit="return confirm('Převést platbu {{ payment.numericValue|default(0) }} Kč na jinou přihlášku? Bankovní údaje zůstanou beze změny.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('payment_transfer_' ~ payment.id) }}">
                                            <input type="text" name="targetParticipant" class="form-control form-control-sm"
                                                   placeholder="ID přihlášky nebo e-mail" style="width:14rem;" required>
                                            <div class="small text-muted" style="margin:.25rem 0;">
                                                Tady přibude záporná platba, na cílové přihlášce kladná.
                                                Původní bankovní platba zůstane beze změny a účastníkům
                                                se nic nerozešle.
                                            </div>
                                            {# Plná oranžová = pohyb peněz. Dřív červená, jenže ta v administraci
                                               znamená mazání — a tohle nic nemaže, jen přesouvá platbu jinam.
                                               ⚠️ Oranžový OBRYS použít nelze: změřený kontrast 2,01 (limit 4,5).
                                               Plná oranžová s černým textem má 10,45 a je z palety UP. #}
                                            <button type="submit" class="btn btn-sm btn-warning">Převést platbu</button>
                                        </form>
                                    </details>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted">Zatím žádné platby.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {# Ruční zadání platby.

               Do 26. 8. 2026 to v administraci NEŠLO: platba mohla vzniknout jedině importem
               bankovního výpisu nebo převodem od jiné přihlášky. Hotovost převzatá u stolu ani
               převod, který se nespároval, se zadat nedaly — a v appce to přitom šlo.

               ⚠️ Potvrzení odchází OKAMŽITĚ, ne cronem. Proto je zaškrtávátko a je VYPNUTÉ:
               ruční zadání bývá oprava nebo hotovost z ruky do ruky, kdy člověk stojí u stolu. #}
            <details style="margin-bottom:1.5rem;">
                <summary style="cursor:pointer; color:var(--oa-primary);">Zadat platbu ručně</summary>
                <form method="post" style="margin-top:.6rem;"
                      action="{{ path('oswis_org_oswis_calendar_web_admin_participant_payment_new', { participantId: participantId }) }}"
                      onsubmit="return confirm('Uložit platbu k přihlášce #{{ participantId }}?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('participant_payment_new_' ~ participantId) }}">
                    <div style="display:flex; flex-wrap:wrap; gap:.6rem; align-items:flex-end;">
                        <div>
                            <label class="small" for="payment-value-{{ participantId }}">Částka (Kč)</label>
                            <input id="payment-value-{{ participantId }}" type="text" inputmode="numeric" name="numericValue"
                                   class="form-control form-control-sm" style="width:8rem;" placeholder="např. 1690" required>
                        </div>
                        <div>
                            <label class="small" for="payment-type-{{ participantId }}">Typ</label>
                            <select id="payment-type-{{ participantId }}" name="type" class="form-control form-control-sm" style="width:11rem;">
                                <option value="cash">hotovost</option>
                                <option value="bank-transfer">bankovní převod</option>
                                <option value="card">karta</option>
                                <option value="on-line">on-line</option>
                                <option value="internal">interní (oprava)</option>
                            </select>
                        </div>
                        <div>
                            <label class="small" for="payment-date-{{ participantId }}">Datum</label>
                            <input id="payment-date-{{ participantId }}" type="date" name="dateTime"
                                   class="form-control form-control-sm" style="width:10rem;" value="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div style="flex:1 1 14rem;">
                            <label class="small" for="payment-note-{{ participantId }}">Poznámka (nepovinná)</label>
                            <input id="payment-note-{{ participantId }}" type="text" name="internalNote" maxlength="255"
                                   class="form-control form-control-sm" placeholder="např. hotovost při příjezdu">
                        </div>
                    </div>
                    <div class="small text-muted" style="margin:.45rem 0;">
                        Záporná částka = <strong>vratka</strong>. Ruční platba nemá bankovní identifikátor,
                        takže se nesplete s importovanou.
                    </div>
                    <label class="small" style="display:block; margin-bottom:.45rem;">
                        <input type="checkbox" name="sendConfirmation" value="1">
                        Poslat účastníkovi potvrzení o platbě <span class="text-muted">(odejde hned)</span>
                    </label>
                    {# Plná oranžová = pohyb peněz, stejně jako „Převést platbu". #}
                    <button type="submit" class="btn btn-sm btn-warning">Uložit platbu</button>
                </form>
            </details>

            <div class="box" style="margin-bottom:1.5rem;">
                <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:.5rem; margin-bottom:.4rem;">
                    <span><strong>Zaplaceno {{ paid }}&nbsp;Kč</strong> <span class="text-muted">z {{ total }}&nbsp;Kč</span></span>
                    <span class="{{ (total > 0 and remaining <= 0) ? 'text-success' : 'text-danger' }}"><strong>{{ (total > 0 and remaining <= 0) ? 'zaplaceno' : 'zbývá ' ~ remaining ~ ' Kč' }}</strong></span>
                </div>
                <div class="progress" style="height:.6rem;">
                    <div class="progress-bar {{ (total > 0 and remaining <= 0) ? 'bg-success' : '' }}" role="progressbar" style="width: {{ pct }}%;" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>

            {# Příznaky — vlastní prvek (ne tabulka): seskupené kategorie s odznaky + inline editor.
               Staví na jazyce aplikace: .box, h4 podnadpisy, nativní .badge, .btn. #}
            <h3 id="priznaky">Příznaky</h3>
            {% if isAdmin|default(false) and flagSelectionModel|default([])|length > 0 %}
                {% set userCats = flagSelectionModel|filter(c => c.groupOffer.isPublicOnWeb) %}
                {% set teamCats = flagSelectionModel|filter(c => not c.groupOffer.isPublicOnWeb) %}
                <div class="box" style="margin-bottom:1.5rem; padding:.4rem 1rem 1rem;">
                    {% for grp in [{ 'title': 'Vyplnil účastník v přihlášce', 'cats': userCats }, { 'title': 'Doplňuje tým', 'cats': teamCats }] %}
                        {% if grp.cats|length > 0 %}
                            {# Zobraz jen nastavené nebo povinné; prázdné volitelné kategorie schovej za „+ Přidat". #}
                            {% set shownCats = grp.cats|filter(c => (c.flagOffers|filter(fo => fo.selected)|length) > 0 or c.min > 0) %}
                            {% set addCats   = grp.cats|filter(c => (c.flagOffers|filter(fo => fo.selected)|length) == 0 and c.min == 0) %}
                            <h4 style="font-size:1.05rem; margin:{{ loop.first ? '.5rem' : '1.2rem' }} 0 .1rem;">{{ grp.title }}</h4>
                            {% for cat in shownCats %}
                                {% include '@OswisOrgOswisCalendar/web_admin/_participant_flag_row.html.twig' with { 'cat': cat, 'participant': participant } only %}
                            {% else %}
                                <div class="text-muted small" style="padding:.4rem 0; border-top:1px solid #e3e9f0;">Zatím nic nenastaveno.</div>
                            {% endfor %}
                            {% if addCats|length > 0 %}
                                <details style="margin-top:.5rem;">
                                    <summary class="btn btn-sm btn-outline-primary" style="display:inline-flex; cursor:pointer;">+ Přidat příznak ({{ addCats|length }})</summary>
                                    <div style="margin-top:.5rem; border-top:1px solid #e3e9f0;">
                                        {% for cat in addCats %}
                                            {% include '@OswisOrgOswisCalendar/web_admin/_participant_flag_row.html.twig' with { 'cat': cat, 'participant': participant } only %}
                                        {% endfor %}
                                    </div>
                                </details>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                {# Read-only fallback (ne-admin, nebo žádné dostupné kategorie) #}
                {% import '@OswisOrgOswisCalendar/web_admin/_macros.html.twig' as ui %}
                <div class="box" style="margin-bottom:1.5rem;">
                    {% for flagGroup in participant.flagGroups|default([]) %}
                        <div style="padding:.3rem 0; border-top:1px solid #e3e9f0;">
                            <strong>{{ flagGroup.flagGroupRange.flagCategory.name|default(flagGroup.name|default('Skupina')) }}:</strong>
                            {% for participantFlag in flagGroup.participantFlags|default([]) %}
                                {% if participantFlag.active|default %}
                                    {{ ui.flag_badge(participantFlag.flagOffer.flag.color, participantFlag.flagOffer.flag.shortName|default(participantFlag.flagOffer.flag.name)) }}
                                {% endif %}
                            {% else %}
                                <em class="text-muted">—</em>
                            {% endfor %}
                        </div>
                    {% else %}
                        <em class="text-muted">Žádné příznaky.</em>
                    {% endfor %}
                </div>
            {% endif %}

            {# Poznámky #}
            <h3 id="poznamky">Poznámky</h3>
            {% set notes = participant.notes|default([]) %}
            <form method="post"
                  action="{{ path('oswis_org_oswis_calendar_web_admin_participant_note_create', { participantId: participant.id }) }}"
                  class="box" style="margin-bottom:1rem;">
                <input type="hidden" name="_token" value="{{ csrf_token('participant_note_create_' ~ participant.id) }}">
                <div style="display:flex; gap:.5rem; align-items:flex-start; flex-wrap:wrap;">
                    <textarea name="textValue" rows="2" placeholder="Nová poznámka…" required
                              class="form-control form-control-sm" style="flex:1 1 22rem; min-width:15rem;"></textarea>
                    <label class="small" style="white-space:nowrap; margin-top:.35rem;">
                        <input type="checkbox" name="publicNote" value="1"> veřejná (vidí účastník)
                    </label>
                    <button type="submit" class="btn btn-sm btn-primary">+ Přidat</button>
                </div>
            </form>
            {% if notes|length == 0 %}
                <p class="text-muted">Žádné poznámky.</p>
            {% else %}
                <table class="list" style="margin-bottom:1.5rem;">
                    <thead><tr><th>Kdy / kdo</th><th>Poznámka</th><th class="text-center">Akce</th></tr></thead>
                    {% for note in notes %}
                        <tbody><tr>
                            <td class="small" style="white-space:nowrap;">
                                {{ note.createdAt|date('j. n. Y H:i', 'Europe/Prague')|default('') }}
                                {% set author = note.createdBy|default %}
                                {% if author %}<div class="block small text-muted">{{ author.shortName|default(author.name|default(author.username|default('—'))) }}</div>{% endif %}
                                <span class="badge {{ note.publicNote|default(false) ? 'text-bg-info' : 'text-bg-secondary' }}">{{ note.publicNote|default(false) ? 'veřejná' : 'interní' }}</span>
                                {# Od 15. 8. se poznámky mažou MĚKCE — bez tohohle rozlišení by smazaná
                                   poznámka vypadala v tabulce jako platná, což je horší než dřívější
                                   tvrdé mazání. Odlišuje se TVAREM (přeškrtnutí, štítek), ne jen barvou. #}
                                {% if note.deleted|default(false) %}
                                    <span class="badge text-bg-danger">smazaná</span>
                                {% endif %}
                            </td>
                            <td style="white-space:pre-line;{{ note.deleted|default(false) ? ' text-decoration:line-through;' : '' }}">{{ note.textValue|default('') }}</td>
                            <td class="text-center">
                                <details>
                                    <summary class="btn btn-sm btn-outline-primary" style="list-style:none;"><twig:ux:icon name="tabler:pencil" class="oa-icon" /></summary>
                                    <div style="text-align:left; margin-top:.4rem; min-width:16rem;">
                                        <form method="post"
                                              action="{{ path('oswis_org_oswis_calendar_web_admin_participant_note_edit', { participantId: participant.id, noteId: note.id }) }}"
                                              style="margin-bottom:.5rem;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('participant_note_edit_' ~ note.id) }}">
                                            <textarea name="textValue" rows="3" class="form-control form-control-sm">{{ note.textValue|default('') }}</textarea>
                                            <label class="small" style="display:block; margin:.25rem 0;">
                                                <input type="checkbox" name="publicNote" value="1" {{ note.publicNote|default(false) ? 'checked' : '' }}> veřejná
                                            </label>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Uložit</button>
                                        </form>
                                        {# Už smazané poznámce se mazání nenabízí — nemá co udělat. #}
                                        {% if not note.deleted|default(false) %}
                                            <form method="post"
                                                  action="{{ path('oswis_org_oswis_calendar_web_admin_participant_note_delete', { participantId: participant.id, noteId: note.id }) }}"
                                                  onsubmit="return confirm('Opravdu smazat tuto poznámku? Tobě zůstane přeškrtnutá, účastníkovi zmizí.');" style="margin:0;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('participant_note_delete_' ~ note.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><twig:ux:icon name="tabler:trash" class="oa-icon" /> Smazat</button>
                                            </form>
                                        {% else %}
                                            <p class="small text-muted" style="margin:0;">Poznámka je smazaná — účastník ji nevidí.</p>
                                        {% endif %}
                                    </div>
                                </details>
                            </td>
                        </tr></tbody>
                    {% endfor %}
                </table>
            {% endif %}

            {# Spolubydlení — spec §5. Zápisová cesta, kterou entita slibovala („ZÁPIS přes web
               admin / službu") a do 15. 8. neexistovala; požadavky šly zadat jen ručně v DB.
               Vazba se ukazuje z OBOU stran: tým ji zadá typicky jen u jednoho z dvojice. #}
            <h3 id="spolubydleni">Spolubydlení</h3>
            {% set roommates = roommatePreferences|default([]) %}
            <form method="post"
                  action="{{ path('oswis_org_oswis_calendar_web_admin_roommate_create', { participantId: participant.id }) }}"
                  class="box" style="margin-bottom:1rem;">
                <input type="hidden" name="_token" value="{{ csrf_token('roommate_create_' ~ participant.id) }}">
                <div style="display:flex; gap:.5rem; align-items:flex-start; flex-wrap:wrap;">
                    <input type="text" name="preferenceText" required maxlength="512"
                           placeholder="S kým chce bydlet (jméno, „chatka pro 4"…)"
                           class="form-control form-control-sm" style="flex:1 1 20rem; min-width:14rem;">
                    <select name="source" class="form-control form-control-sm" style="flex:0 0 9rem;"
                            title="Odkud požadavek přišel">
                        <option value="email">z e-mailu</option>
                        <option value="registration">z přihlášky</option>
                        <option value="other">jinak</option>
                    </select>
                    <input type="number" name="withParticipantId" min="1" placeholder="#ID"
                           class="form-control form-control-sm" style="flex:0 0 6rem;"
                           title="Nepovinné — číslo přihlášky toho druhého. Vyplň, jen když je jméno víceznačné nebo se nespáruje samo.">
                    <button type="submit" class="btn btn-sm btn-primary">+ Přidat</button>
                </div>
                <p class="small text-muted" style="margin:.4rem 0 0;">
                    Jméno se spáruje automaticky proti účastníkům téhož turnusu. Nespárovaný požadavek
                    u příjezdu nezafunguje — dvojice se pak může rozdělit.
                </p>
            </form>
            {% if roommates|length == 0 %}
                <p class="text-muted">Žádný požadavek na spolubydlení.</p>
            {% else %}
                <table class="list" style="margin-bottom:1.5rem;">
                    <thead><tr><th>Stav</th><th>Požadavek</th><th>Spárováno s</th><th class="text-center">Akce</th></tr></thead>
                    {% for preference in roommates %}
                        {# Druhá strana vazby z pohledu TOHOTO účastníka — u požadavku, který zadal
                           někdo jiný, je „ten druhý" naopak jeho autor. #}
                        {% set isOwn = preference.participant is not null and preference.participant.id == participant.id %}
                        {% set counterpart = isOwn ? preference.withParticipant : preference.participant %}
                        <tbody><tr>
                            <td style="white-space:nowrap;">
                                {# Odlišeno TVAREM i slovem, ne jen barvou. #}
                                {% if preference.status == 'ok' %}
                                    <span class="badge text-bg-success">✓ spárováno</span>
                                {% elseif preference.status == 'conflict' %}
                                    <span class="badge text-bg-danger">! konflikt</span>
                                {% else %}
                                    <span class="badge text-bg-warning">? bez shody</span>
                                {% endif %}
                                <div class="block small text-muted">
                                    {% if preference.source == 'registration' %}z přihlášky
                                    {% elseif preference.source == 'email' %}z e-mailu
                                    {% else %}jinak{% endif %}
                                </div>
                            </td>
                            <td>
                                {{ preference.preferenceText|default('—') }}
                                {% if not isOwn %}
                                    <div class="block small text-muted">
                                        požadavek zadal někdo jiný — tenhle účastník je v něm uveden
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                {% if counterpart %}
                                    <a href="{{ path('oswis_org_oswis_calendar_web_admin_participant_detail', { participantId: counterpart.id }) }}">
                                        {{ counterpart.contact.name|default('#' ~ counterpart.id) }}
                                    </a>
                                    <div class="block small text-muted">#{{ counterpart.id }}{% if counterpart.event %} · {{ counterpart.event.name }}{% endif %}</div>
                                {% elseif preference.status == 'conflict' %}
                                    <em class="small">jméno sedí na víc lidí nebo na jiný turnus — vyber přihlášku ručně</em>
                                {% else %}
                                    <em class="small text-muted">nikdo takový zatím není přihlášený</em>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <form method="post"
                                      action="{{ path('oswis_org_oswis_calendar_web_admin_roommate_delete', { participantId: participant.id, preferenceId: preference.id }) }}"
                                      onsubmit="return confirm('Opravdu smazat tento požadavek na spolubydlení?');" style="margin:0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('roommate_delete_' ~ preference.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><twig:ux:icon name="tabler:trash" class="oa-icon" /></button>
                                </form>
                            </td>
                        </tr></tbody>
                    {% endfor %}
                </table>
                {# Přepárování má smysl jen když je co párovat — lidé se hlásí průběžně. #}
                {% if roommates|filter(p => p.status != 'ok')|length > 0 %}
                    <form method="post" action="{{ path('oswis_org_oswis_calendar_web_admin_roommate_rematch') }}"
                          style="margin:-1rem 0 1.5rem;">
                        <input type="hidden" name="_token" value="{{ csrf_token('roommate_rematch') }}">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            Přepárovat nespárované požadavky
                        </button>
                        <span class="small text-muted">projde celou akci, ne jen tohoto účastníka</span>
                    </form>
                {% endif %}
            {% endif %}

            {# Historie a komunikace #}
            <h3 id="historie">Historie a komunikace</h3>
            <span id="komunikace"></span>
            {% include '@OswisOrgOswisCalendar/web_admin/_participant_timeline.html.twig' with {
                timeline:          timeline|default([]),
                isAdmin:           isAdmin|default(true),
                participantId:     participantId|default(participant.id),
                resendableMailIds: resendableMailIds|default({}),
            } only %}
        {% endif %}
    </div>

    {# Obsluha zaškrtávátka „překročit kapacitu" — JEDNOU na stránku.
       V partialu _participant_flag_row byla vykreslená 22× (jednou za kategorii). #}
    <script>
        (function () {
            if (window.__oswisKapacitaInit) { return; }
            window.__oswisKapacitaInit = true;
            document.addEventListener('change', function (event) {
                var box = event.target;
                if (!box || box.name !== 'admin_override') { return; }
                var form = box.closest('form');
                if (!form) { return; }
                var plne = form.querySelectorAll('.oa-opt--full input[name="flagOfferIds[]"]');
                for (var i = 0; i < plne.length; i++) {
                    // Volbu, kterou účastník už má, needitujeme — ta zakázaná není a odškrtnout ji nesmíme.
                    if (plne[i].defaultChecked) { continue; }
                    plne[i].disabled = !box.checked;
                    if (!box.checked) { plne[i].checked = false; }
                }
            });
        })();
    </script>
{% endblock body_content %}
