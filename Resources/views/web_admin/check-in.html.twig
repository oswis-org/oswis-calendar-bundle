{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{# Check-in obrazovka per turnus (modul D2, Fáze A). Rychlé označení příjezdu, present-count/no-show,
   řazení (dietáři-first / pásek / abecedně), partial-stay + platba na řádku. Data: WebAdminCheckInController. #}

{% block body_content %}
    <div class="container-fluid" style="padding: 1rem;">
        <div class="row">
            <div class="col" style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                <h2 style="margin: 0;">Check-in — {{ event.name ?? eventSlug }}</h2>
                <span class="badge bg-success" style="font-size: 1rem;">Přijelo {{ arrived }} / {{ total }}</span>
                {% if noShow > 0 %}
                    <span class="badge bg-secondary" style="font-size: 1rem;">Nepřijelo {{ noShow }}</span>
                {% endif %}
                <a class="btn btn-sm btn-outline-primary" style="margin-left: auto;"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_progress', { eventSlug: eventSlug }) }}">📊 Průběh příjezdu</a>
                <a class="btn btn-sm btn-outline-primary"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_stations', { eventSlug: eventSlug }) }}">⚙ Konfigurace stanic</a>
            </div>
        </div>

        <div class="row" style="margin-top: .5rem;">
            <div class="col" style="display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;">
                <span class="text-muted small">Řadit:</span>
                {% set sorts = { diet: 'Dietáři první', band: 'Dle pásku', alpha: 'Abecedně' } %}
                {% for key, label in sorts %}
                    <a class="btn btn-sm {{ sort == key ? 'btn-primary' : 'btn-outline-secondary' }}"
                       href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_list', { eventSlug: eventSlug, sort: key }) }}">{{ label }}</a>
                {% endfor %}
                <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener" style="margin-left: auto;"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_pdf', { eventSlug: eventSlug, sort: sort }) }}">🖨 Tisk PDF</a>
                <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_safety_pdf', { eventSlug: eventSlug }) }}">🖊 Bezpečnostní listy</a>
                <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener"
                   href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_band_pdf', { eventSlug: eventSlug }) }}">🎗 Seznam dle pásku</a>
            </div>
        </div>

        <div class="row" style="margin-top: .75rem;">
            <div class="col" style="overflow-x: auto;">
                <table class="table table-sm table-hover" style="min-width: 720px;">
                    <thead>
                        <tr>
                            <th style="width: 3rem;">#</th>
                            <th>Jméno</th>
                            <th>Skupina / pásek</th>
                            <th>Platba</th>
                            <th>Partial-stay</th>
                            <th style="width: 12rem;">Příjezd</th>
                            <th style="width: 11rem;">Tričko</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in participants %}
                            {% set g = p.group %}
                            {% set remaining = p.remainingPrice %}
                            <tr class="{{ p.arrived ? 'table-success' : '' }}">
                                <td>{{ loop.index }}</td>
                                <td>
                                    <a href="{{ path('oswis_org_oswis_calendar_web_admin_participant_detail', { participantId: p.id }) }}"
                                       target="_blank" rel="noopener">{{ p.contact.name ?? ('#' ~ p.id) }}</a>
                                </td>
                                <td>
                                    {% if g %}
                                        {% if g.color %}
                                            <span style="display: inline-block; width: .9rem; height: .9rem; border-radius: 50%; background: {{ g.color }}; border: 1px solid #999; vertical-align: middle;"></span>
                                        {% endif %}
                                        {{ g.name ?? '—' }}
                                    {% else %}
                                        <span class="text-muted">bez skupiny</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if remaining > 0 %}
                                        <span class="text-danger">zbývá {{ remaining }} Kč</span>
                                    {% else %}
                                        <span class="text-success">zaplaceno</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if p.plannedArrival %}<span class="badge bg-warning text-dark" title="pozdější příjezd">⏱ {{ p.plannedArrival }}</span>{% endif %}
                                    {% if p.plannedDeparture %}<span class="badge bg-warning text-dark" title="dřívější odjezd">↩ {{ p.plannedDeparture }}</span>{% endif %}
                                </td>
                                <td>
                                    <form method="post" style="margin: 0;"
                                          action="{{ path('oswis_org_oswis_calendar_web_admin_checkin_arrived', { participantId: p.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('checkin_arrived_' ~ p.id) }}">
                                        <input type="hidden" name="return" value="{{ app.request.requestUri }}">
                                        {% if p.arrived %}
                                            <button type="submit" class="btn btn-sm btn-success" title="Zrušit příjezd (překlik)">
                                                ✓ přijel {{ p.arrivedAt|date('H:i') }}
                                            </button>
                                        {% else %}
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Přijel</button>
                                        {% endif %}
                                    </form>
                                </td>
                                <td>
                                    {% set size = p.tShirt %}
                                    <form method="post" style="margin: 0;"
                                          action="{{ path('oswis_org_oswis_calendar_web_admin_checkin_tshirt', { participantId: p.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('checkin_tshirt_' ~ p.id) }}">
                                        <input type="hidden" name="return" value="{{ app.request.requestUri }}">
                                        {% if p.tShirtHandedOver %}
                                            <button type="submit" class="btn btn-sm btn-success" title="Zrušit výdej (překlik)">✓ vydáno{% if size %} ({{ size }}){% endif %}</button>
                                        {% else %}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Vydat{% if size %} {{ size }}{% endif %}</button>
                                        {% endif %}
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center text-muted">Žádní účastníci v tomto turnusu.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
