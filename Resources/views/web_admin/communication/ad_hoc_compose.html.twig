{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{% block html_title %}{{ page_title }}{% endblock %}

{% block body_content %}
    <main class="container">
        <h2>{{ pageTitle }}</h2>

        {# Ne `|default`: kontakt bez jména má prázdné __toString() → Twig by ho vyhodnotil jako empty a skryl i e-mail s telefonem. #}
        {% if participant.contact is not null %}
            <p>
                <strong>Příjemce:</strong>
                {{ participant.contact.name|default('(bez jména)') }}
                {% if participant.contact.email|default %}
                    · {{ participant.contact.email }}
                {% endif %}
            </p>
        {% endif %}

        <p>
            <a href="{{ path('oswis_org_oswis_calendar_web_admin_participant_detail', { participantId: participant.id, _fragment: 'komunikace' }) }}"
               class="btn btn-sm btn-link">← Zpět na historii komunikace</a>
        </p>

        {% include '@OswisOrgOswisCalendar/web_admin/mail/_problems.html.twig' with { validation: validation|default(null) } only %}

        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_row(form.subject) }}
        <div class="row">
            <div class="col-md-8 mb-3">
                {{ form_label(form.body) }}
                {{ form_widget(form.body) }}
                {{ form_errors(form.body) }}
                {% include '@OswisOrgOswisCalendar/web_admin/mail/_body_help.html.twig' with { recipientCount: 1 } only %}
            </div>
            <div class="col-md-4 mb-3">
                {% include '@OswisOrgOswisCalendar/web_admin/mail/_insert_panel.html.twig' with { catalog: variableCatalog|default({}), target: form.body.vars.id } only %}
            </div>
        </div>
        <p class="text-muted">
            <small>E-mail odejde na všechny adresy přihlášky s aktivovaným účtem a uloží se do historie komunikace.</small>
        </p>
        {% include '@OswisOrgOswisCalendar/web_admin/mail/_confirm_warnings.html.twig' with { validation: validation|default(null) } only %}
        <div class="mb-3">
            <button type="button" class="btn btn-outline-secondary" id="mailPreviewBtn"><twig:ux:icon name="tabler:eye" class="oa-icon" /> Náhled</button>
            {{ form_widget(form.submit) }}
        </div>
        {{ form_end(form) }}

        {% include '@OswisOrgOswisCalendar/web_admin/mail/_preview.html.twig' with {
            ids: participant.id ~ '', subjectField: form.subject.vars.id, bodyField: form.body.vars.id
        } only %}
    </main>
{% endblock %}
