{#
    Nabídka „Vložit" — proměnné, podmínky a bloky z katalogu (MailCatalog::groupedForPanel()); klik vloží
    značku na místo kurzoru do pole s id `target`. Společné pro jednotlivou i hromadnou zprávu.
    Parametry: catalog (array<skupina, list<{label, token}>>), target (id textového pole).
#}
<label class="form-label">Vložit (klikni)</label>
<div class="mail-insert-panel" data-target="{{ target }}"
     style="border:1px solid #dee2e6;border-radius:.375rem;padding:.5rem;max-height:420px;overflow:auto;">
    {% for group, items in catalog|default({}) %}
        <div style="font-size:.8em;color:#6c757d;text-transform:uppercase;margin:.3rem 0 .15rem;">{{ group }}</div>
        {% for item in items %}
            <button type="button" class="btn btn-sm btn-outline-secondary" style="margin:.1rem;font-size:.85em;"
                    data-token="{{ item.token|e('html_attr') }}">{{ item.label }}</button>
        {% endfor %}
    {% endfor %}
</div>
<script>
    (function () {
        var panel = document.currentScript.previousElementSibling;
        var field = document.getElementById(panel.getAttribute('data-target'));
        if (!field) { return; }
        function insertAtCursor(text) {
            var s = field.selectionStart, e = field.selectionEnd;
            field.value = field.value.slice(0, s) + text + field.value.slice(e);
            field.selectionStart = field.selectionEnd = s + text.length;
            field.focus();
        }
        panel.addEventListener('click', function (ev) {
            var button = ev.target.closest('[data-token]');
            if (button) { insertAtCursor(button.getAttribute('data-token')); }
        });
        // Jako v editoru kódu: Tab vloží dvě mezery místo odchodu z pole.
        field.addEventListener('keydown', function (ev) {
            if (ev.key === 'Tab' && !ev.shiftKey) { ev.preventDefault(); insertAtCursor('  '); }
        });
    })();
</script>
