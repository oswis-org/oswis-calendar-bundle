{#
    Náhled zprávy přesně tak, jak odejde (kontrola + vykreslení na serveru, WebAdminBulkMailController::preview).
    Vložit AŽ ZA tlačítka: `#mailPreviewBtn` = první příjemce; `.mail-preview-one[data-pid]` kdekoli na stránce =
    konkrétní příjemce. Parametry: ids (čárkami oddělená ID přihlášek), subjectField, bodyField (id polí),
    templateField (id výběru kampaně, nepovinné).
#}
<div id="mailPreviewWrap" class="mt-3" hidden>
    <h3>Náhled <small class="text-muted" id="mailPreviewFor"></small></h3>
    <div class="btn-group mb-2" role="group" aria-label="Šířka náhledu">
        <button type="button" class="btn btn-sm btn-outline-secondary active" data-preview-width="640px"><twig:ux:icon name="tabler:device-desktop" class="oa-icon" /> Desktop</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-preview-width="360px"><twig:ux:icon name="tabler:device-mobile" class="oa-icon" /> Mobil</button>
    </div>
    <div id="mailPreviewShell" style="background:#e9ecef;padding:.5rem;border:1px solid #ccc;max-width:640px;">
        <iframe id="mailPreviewFrame" title="Náhled e-mailu" style="display:block;width:100%;height:600px;border:1px solid #ccc;background:#fff;"></iframe>
    </div>
</div>

<script>
    (function () {
        var PREVIEW_URL = {{ path('oswis_org_oswis_calendar_web_admin_bulk_mail_preview')|json_encode|raw }};
        var TOKEN = {{ csrf_token('bulk_mail_preview')|json_encode|raw }};
        var IDS = {{ ids|json_encode|raw }};
        var subject = document.getElementById({{ subjectField|json_encode|raw }});
        var body = document.getElementById({{ bodyField|json_encode|raw }});
        var template = {{ templateField|default('')|json_encode|raw }} ? document.getElementById({{ templateField|default('')|json_encode|raw }}) : null;
        var wrap = document.getElementById('mailPreviewWrap');
        var shell = document.getElementById('mailPreviewShell');

        Array.prototype.forEach.call(wrap.querySelectorAll('[data-preview-width]'), function (b) {
            b.addEventListener('click', function () {
                shell.style.maxWidth = b.getAttribute('data-preview-width');
                Array.prototype.forEach.call(wrap.querySelectorAll('[data-preview-width]'), function (o) { o.classList.toggle('active', o === b); });
            });
        });

        function runPreview(pid, who, sourceBtn) {
            var fd = new FormData();
            fd.append('_token', TOKEN);
            fd.append('idsCsv', IDS);
            fd.append('subject', subject ? subject.value : '');
            fd.append('body', body ? body.value : '');
            fd.append('templateSlug', template ? template.value : '');
            fd.append('previewParticipantId', pid || '');
            var label = sourceBtn.innerHTML;
            sourceBtn.disabled = true;
            sourceBtn.textContent = 'Generuji…';
            fetch(PREVIEW_URL, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    wrap.hidden = false;
                    document.getElementById('mailPreviewFor').textContent = who ? '— ' + who : '';
                    document.getElementById('mailPreviewFrame').srcdoc = html;
                    wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
                })
                .catch(function () {
                    wrap.hidden = false;
                    document.getElementById('mailPreviewFrame').srcdoc = '<p style="font-family:sans-serif;color:#842029">Náhled se nepodařilo vytvořit (spojení se serverem).</p>';
                })
                .finally(function () { sourceBtn.disabled = false; sourceBtn.innerHTML = label; });
        }

        var first = document.getElementById('mailPreviewBtn');
        first.addEventListener('click', function () { runPreview('', '', first); });
        Array.prototype.forEach.call(document.querySelectorAll('.mail-preview-one[data-pid]'), function (b) {
            b.addEventListener('click', function () { runPreview(b.getAttribute('data-pid'), b.getAttribute('data-name'), b); });
        });
    })();
</script>
