{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{# Přidání/úprava check-in stanice (modul D2). Vzor = event_edit.html.twig. Form: CheckInStationEditType. #}

{% block html_title %}{{ page_title|default(pageTitle) }}{% endblock %}

{% block body_content %}
    <main class="container" style="padding-bottom: 6rem;">
        <div style="display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: .25rem;">
            <h2 style="margin: 0;">{{ pageTitle|default(isNew ? 'Nová stanice' : 'Upravit stanici') }}</h2>
            <a href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_stations', { eventSlug: eventSlug }) }}"
               class="btn btn-sm btn-link">← Zpět na stanice</a>
        </div>

        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

        <fieldset class="admin-fieldset">
            <legend>Stanice</legend>
            <div class="row">
                <div class="col-12 col-md-6 mb-3">{{ form_row(form.name) }}</div>
                <div class="col-12 col-md-4 mb-3">{{ form_row(form.stationKind) }}</div>
                <div class="col-12 col-md-2 mb-3">{{ form_row(form.orderNumber) }}</div>
            </div>
            <div class="row">
                <div class="col-12 col-md-6 mb-3">{{ form_row(form.icon) }}</div>
                <div class="col-12 col-md-6 mb-3 d-flex align-items-end gap-3">
                    {{ form_row(form.requiresOnline) }}
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>Zachytávaná hodnota (nepovinné)</legend>
            <div class="row">
                <div class="col-12 col-md-4 mb-3 d-flex align-items-end">{{ form_row(form.capturesValue) }}</div>
                <div class="col-12 col-md-8 mb-3">{{ form_row(form.valueLabel) }}</div>
            </div>
            <div class="row">
                <div class="col-12 mb-3">{{ form_row(form.valueOptionsText) }}</div>
            </div>
        </fieldset>

        <div style="position: sticky; bottom: 0; background: rgba(255,255,255,.95); border-top: 1px solid #dee2e6; padding: .75rem 0; margin-top: 1rem; display: flex; gap: .5rem; justify-content: flex-end;">
            <a href="{{ path('oswis_org_oswis_calendar_web_admin_checkin_stations', { eventSlug: eventSlug }) }}"
               class="btn btn-link">Zrušit</a>
            {{ form_row(form.submit, { attr: { class: 'btn btn-primary' } }) }}
        </div>
        {{ form_end(form) }}
    </main>
{% endblock %}
