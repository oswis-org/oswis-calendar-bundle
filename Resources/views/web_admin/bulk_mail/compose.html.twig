{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{% block html_title %}{{ pageTitle }}{% endblock %}

{% block body_content %}
    <main class="container">
        {# Jeden příjemce = „Nová zpráva" z detailu přihlášky (stránka patří k Účastníkům); jinak hromadný e-mail. #}
        {% if participant is null %}
            {% include '@OswisOrgOswisCalendar/web_admin/parts/communication-subnav.html.twig' with { current: 'bulk' } only %}
        {% endif %}
        <h2><twig:ux:icon name="tabler:mail" class="oa-icon" /> {{ pageTitle }}</h2>
        {% if koncept is not null %}
            <p class="text-muted small" data-koncept-info>
                Rozepsaný koncept #{{ koncept.id }}{% if koncept.updatedAt %}, naposledy uložen {{ koncept.updatedAt|date('j. n. Y H:i') }}{% endif %}{% if koncept.adminName %} ({{ koncept.adminName }}){% endif %}.
                Dokud ho neodešleš, nikomu nic neodejde.
            </p>
        {% endif %}
        <p>
            {% if participant is not null %}
                <a href="{{ path('oswis_org_oswis_calendar_web_admin_participant_detail', { participantId: participant.id, _fragment: 'komunikace' }) }}" class="btn btn-sm btn-link">← Zpět na historii komunikace</a>
            {% else %}
                <a href="{{ path('oswis_org_oswis_calendar_web_admin_participants_list') }}" class="btn btn-sm btn-link">← Zpět na seznam přihlášek</a>
            {% endif %}
            · <a href="{{ path('oswis_org_oswis_calendar_web_admin_bulk_mail_status') }}" class="btn btn-sm btn-link">Stav hromadných e-mailů</a>
        </p>

        <div class="alert alert-info">
            {% if participant is not null %}
                {# Ne `|default`: kontakt bez jména má prázdné __toString(). #}
                <strong>Příjemce:</strong> {{ participant.contact ? (participant.contact.name|default('(bez jména)')) : '(bez kontaktu)' }}
                {%- if participant.contact and participant.contact.appUser %} · {{ participant.contact.appUser.email }}{% endif %}.
                Zpráva odejde na všechny adresy přihlášky s aktivovaným účtem a uloží se do historie komunikace;
                začne se odesílat za 30 sekund (do té doby jde zrušit), nebo ve zvolený čas.
            {% else %}
                <strong>Příjemců: {{ recipientCount }}</strong> {{ recipientCount == 1 ? 'přihláška' : (recipientCount < 5 ? 'přihlášky' : 'přihlášek') }}.
                Každá přihláška = nejméně 1 e-mailová adresa (organizace může mít více).
                Jde o <strong>reálné odeslání</strong> živým lidem — zkontrolujte text a náhled.
            {% endif %}
        </div>

        {% include '@OswisOrgOswisCalendar/web_admin/bulk_mail/_denni_limit.html.twig' with { limit: limit, recipientCount: recipientCount } only %}

        {% if participant is null %}
        {# Seznam příjemců — kdo přesně zprávu dostane (náhled pro kohokoli z nich je u textu). #}
        <details class="mb-3"{{ recipientCount <= 25 ? ' open' : '' }}>
            <summary style="cursor:pointer;font-weight:600;"><twig:ux:icon name="tabler:clipboard-list" class="oa-icon" /> Seznam příjemců ({{ recipientCount }}) — zobrazit / skrýt</summary>
            <div style="max-height:320px;overflow:auto;border:1px solid #dee2e6;border-radius:.375rem;margin-top:.5rem;">
                <table class="list" style="width:100%;margin:0;">
                    <thead>
                        <tr>
                            <th style="width:3rem;">#</th>
                            <th>Jméno</th>
                            <th>Akce</th>
                            <th>E-mail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in recipients|default([]) %}
                            <tr>
                                <td>{{ r.id }}</td>
                                <td>{{ r.contact ? (r.contact.name|default('(bez jména)')) : '(bez kontaktu)' }}</td>
                                <td>{{ r.event ? (r.event.shortName|default(r.event.name)|default('—')) : '—' }}</td>
                                <td><small>{{ (r.contact and r.contact.appUser) ? r.contact.appUser.email : '—' }}</small></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" style="text-align:center;color:#6c757d;">Žádní příjemci.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </details>
        {% endif %}

        {% include '@OswisOrgOswisCalendar/web_admin/mail/_problems.html.twig' with { validation: validation|default(null) } only %}

        {# Formulář BulkMailType (28. 9. 2026): CSRF a kontrola formulářem, chyba u pole, kterého se týká. #}
        {{ form_start(form, { attr: {
            id: 'bulkMailForm',
            novalidate: 'novalidate',
        } }) }}
            {{ form_widget(form.idsCsv) }}
            {{ form_widget(form.konceptId) }}
            {{ form_widget(form.konceptRevize) }}
            {{ form_row(form.subject) }}

            {# Režim: vlastní text (Twig) NEBO celá uložená kampaň. #}
            <div class="mb-3">
                {{ form_widget(form.mailMode) }}
                {{ form_errors(form.mailMode) }}
            </div>

            <div class="mb-3" id="bmTemplateSection">
                {{ form_row(form.templateSlug) }}
            </div>

            {# Text zprávy v editoru; náhled vedle ukazuje zprávu (nebo kampaň) pro vybraného příjemce. #}
            <div id="bmBodySection" class="mb-3">
                {{ form_row(form.body) }}
            </div>

            <div class="mb-3" style="max-width: 20rem;">{{ form_row(form.sendAt) }}</div>

            {# Kontrola před odesláním (spec §5.2, dávka 3.3): ukáže se po „Zkontrolovat…"; zařadí až „Odeslat" z panelu. #}
            {% if kontrola is not null %}
                {% set chyby = validation is not null and validation.hasErrors %}
                {% set naplanovano = form.sendAt.vars.data is not null %}
                <section class="card mb-3 {{ chyby or kontrola.zprav == 0 ? 'border-danger' : 'border-primary' }}" aria-labelledby="kontrola-nadpis" data-kontrola>
                    <div class="card-body">
                        <h3 class="h5" id="kontrola-nadpis">Kontrola před odesláním</h3>
                        <p class="mb-2">
                            Odejde <strong>{{ kontrola.zprav }} {{ kontrola.zprav == 1 ? 'zpráva' : (kontrola.zprav < 5 ? 'zprávy' : 'zpráv') }}</strong>
                            pro {{ kontrola.prihlasek }} {{ kontrola.prihlasek == 1 ? 'přihlášku' : (kontrola.prihlasek < 5 ? 'přihlášky' : 'přihlášek') }}
                            {{- naplanovano ? ', naplánováno na ' ~ form.sendAt.vars.data|date('j. n. Y H:i') : ', začne se za 30 sekund (do té doby jde zrušit)' }}.
                        </p>
                        {% if limit.remaining is not null and kontrola.zprav > limit.remaining %}
                            <p class="mb-2 text-warning-emphasis">Do dnešního limitu se vejde {{ limit.remaining }} — zbytek odejde automaticky zítra.</p>
                        {% endif %}
                        {% if kontrola.vypadnou is not empty %}
                            <details class="mb-2"{{ kontrola.vypadnou|length <= 10 ? ' open' : '' }}>
                                <summary>Nedostanou nic: {{ kontrola.vypadnou|length }}</summary>
                                <ul class="small mb-0 mt-1">
                                    {% for v in kontrola.vypadnou %}<li>{{ v.popis }} — {{ v.duvod }}</li>{% endfor %}
                                </ul>
                            </details>
                        {% endif %}
                        {% if kontrola.zprav == 0 %}
                            <p class="text-danger mb-0">Nikdo z vybraných zprávu nedostane — není co odeslat.</p>
                        {% elseif chyby %}
                            <p class="text-danger mb-0">Zpráva má chyby (výše) — po opravě ji zkontroluj znovu.</p>
                        {% else %}
                            {% include '@OswisOrgOswisCalendar/web_admin/mail/_confirm_warnings.html.twig' with { validation: validation } only %}
                            <button type="submit" name="odeslat" value="1" class="btn btn-primary">
                                <twig:ux:icon name="tabler:mail" class="oa-icon" /> {{ naplanovano ? 'Naplánovat' : 'Odeslat' }} ({{ kontrola.zprav }})
                            </button>
                            <span class="small text-muted ms-2">Když text ještě změníš, zkontroluj ho znovu tlačítkem níže.</span>
                        {% endif %}
                    </div>
                </section>
            {% endif %}
            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn {{ kontrola is null ? 'btn-primary' : 'btn-outline-primary' }}">
                    <twig:ux:icon name="tabler:circle-check" class="oa-icon" /> {{ kontrola is null ? 'Zkontrolovat a odeslat…' : 'Zkontrolovat znovu' }}
                </button>
                {{ form_widget(form.ulozitKoncept) }}
                <span class="small text-muted">Nic se zatím neodešle — nejdřív se ukáže, kolik zpráv a komu odejde. Koncept se uloží i nedopsaný (rozepsaná zpráva se ukládá i sama).</span>
                <span class="small text-muted w-100" role="status" aria-live="polite" data-autosave-stav></span>
            </div>
        {{ form_end(form) }}
    </main>

    <script>
        (function () {
            var tplSelect = document.getElementById('{{ form.templateSlug.vars.id }}');
            var bodySection = document.getElementById('bmBodySection');
            var tplSection = document.getElementById('bmTemplateSection');
            var editorRoot = bodySection.querySelector('.mail-editor');
            var bodyLabel = bodySection.querySelector('label[for="{{ form.body.vars.id }}"]');

            // Režim: vlastní text NEBO uložená kampaň. V režimu kampaně se editor skryje a náhled
            // ukazuje kampaň. Co se pošle, rozhoduje server podle zvoleného režimu; vyprázdnění výběru
            // kampaně tu slouží náhledu (bez kampaně ukazuje vlastní text).
            function applyMode(mode) {
                var isTemplate = mode === '{{ constant('OswisOrg\\OswisCalendarBundle\\Form\\WebAdmin\\BulkMailType::MODE_TEMPLATE') }}';
                tplSection.hidden = !isTemplate;
                if (editorRoot) { editorRoot.classList.toggle('mail-editor--template-mode', isTemplate); }
                if (bodyLabel) { bodyLabel.hidden = isTemplate; }
                if (!isTemplate) { tplSelect.value = ''; }
                tplSelect.dispatchEvent(new Event('change'));
            }
            Array.prototype.forEach.call(document.querySelectorAll('input[name="{{ form.mailMode.vars.full_name }}"]'), function (r) {
                r.addEventListener('change', function () { if (r.checked) { applyMode(r.value); } });
                if (r.checked) { applyMode(r.value); }
            });

            // Upozornění při odchodu s neuloženými změnami (spec §5.2). Porovnává obsah formuláře při načtení a teď
            // (editor zapisuje text do skrytého pole formuláře); odeslání formuláře upozornění vypne.
            var form = document.getElementById('bulkMailForm');
            var konceptId = document.getElementById('{{ form.konceptId.vars.id }}');
            var konceptRevize = document.getElementById('{{ form.konceptRevize.vars.id }}');
            var stavUlozeni = document.querySelector('[data-autosave-stav]');
            function snimek() { return new URLSearchParams(new FormData(form)).toString(); }
            var puvodni = null;
            window.addEventListener('load', function () { puvodni = snimek(); });
            var odesila = false;
            window.addEventListener('beforeunload', function (e) {
                if (odesila || puvodni === null || snimek() === puvodni) { return; }
                e.preventDefault();
                e.returnValue = '';
            });

            // Automatické ukládání konceptu (spec §5.2): po změně a chvíli klidu se formulář uloží jako koncept
            // (týmž požadavkem jako „Uložit koncept", JSON místo přesměrování). Nikdy nic neodešle. Souběh hlídá
            // revize — když koncept mezitím změnilo jiné okno, ukládání se zastaví a autor to uvidí.
            // Prodleva po poslední změně; `data-autosave-ms` na formuláři ji zkracuje (testy v prohlížeči).
            function prodleva() { return parseInt(form.getAttribute('data-autosave-ms') || '15000', 10); }
            var casovac = null;
            var probiha = null;
            var zastaveno = false;
            function oznamit(text, chyba) {
                if (!stavUlozeni) { return; }
                stavUlozeni.textContent = text;
                stavUlozeni.classList.toggle('text-danger', !!chyba);
            }
            function maObsah() {
                var data = new FormData(form);
                return String(data.get('{{ form.subject.vars.full_name }}') || '').trim() !== ''
                    || String(data.get('{{ form.body.vars.full_name }}') || '').replace(/<[^>]*>/g, '').trim() !== '';
            }
            function ulozit() {
                casovac = null;
                if (zastaveno || odesila || probiha || puvodni === null || !maObsah()) { return Promise.resolve(); }
                var stav = snimek();
                if (stav === puvodni) { return Promise.resolve(); }
                var data = new FormData(form);
                data.append('{{ form.ulozitKoncept.vars.full_name }}', '');
                data.append('autosave', '1');
                oznamit('Ukládám koncept…', false);
                probiha = fetch(form.action, { method: 'POST', body: data, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) {
                        var json = (r.headers.get('Content-Type') || '').indexOf('application/json') !== -1;
                        return (json ? r.json() : Promise.resolve({ error: 'invalid' })).then(function (p) { return { status: r.status, p: p }; });
                    })
                    .then(function (v) {
                        if (v.status === 200 && v.p.id) {
                            // Psal autor během ukládání? Pak uložené není všechno — upozornění při odchodu zůstane a uloží se znovu.
                            var psalBehem = snimek() !== stav;
                            konceptId.value = String(v.p.id);
                            konceptRevize.value = String(v.p.revision);
                            if (psalBehem) { naplanovat(); } else { puvodni = snimek(); }
                            oznamit('Koncept uložen automaticky v ' + new Date(v.p.savedAt).toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' }) + '.', false);
                        } else if (v.status === 409) {
                            zastaveno = true;
                            oznamit((v.p && v.p.message) || 'Koncept se mezitím změnil v jiném okně — automatické ukládání zastaveno.', true);
                        } else {
                            oznamit('Koncept se automaticky neuložil (formulář má chybu) — ulož ho tlačítkem.', true);
                        }
                    })
                    .catch(function () { oznamit('Koncept se automaticky neuložil (spojení) — zkusím to znovu.', true); naplanovat(); })
                    .then(function () { probiha = null; });
                return probiha;
            }
            function naplanovat() {
                if (zastaveno || odesila) { return; }
                if (casovac) { clearTimeout(casovac); }
                casovac = setTimeout(ulozit, prodleva());
            }
            form.addEventListener('input', naplanovat);
            form.addEventListener('change', naplanovat);
            // Editor (Stimulus `mail-editor`) hlásí změnu textu událostí, která probublá až k formuláři.
            form.addEventListener('mail-editor:change', naplanovat);

            // Odeslání formuláře během ukládání: počkat, až ukládání doběhne (nová revize do formuláře), pak odeslat —
            // jinak by „Odeslat" neslo starou revizi a skončilo souběhem.
            form.addEventListener('submit', function (e) {
                if (casovac) { clearTimeout(casovac); casovac = null; }
                if (probiha) {
                    e.preventDefault();
                    var tlacitko = e.submitter || null;
                    probiha.then(function () { form.requestSubmit(tlacitko); });
                    return;
                }
                odesila = true;
            });
        })();
    </script>
{% endblock %}
