{# Jedna příznaková kategorie jako rozbalovací prvek (ne tabulka). Mřížkové zarovnání
   summary: název | hodnota | upravit — konzistentní sloupce napříč řádky, bez plovoucího
   prázdna. Po rozkliknutí editor. Třídy .oa-flag* jsou v app.scss. #}
{% import '@OswisOrgOswisCalendar/web_admin/_macros.html.twig' as ui %}
{% set single = cat.max == 1 %}
{% set selectedFlags = cat.flagOffers|filter(fo => fo.selected) %}
<details class="oa-flag" name="oa-flag-edit">
    <summary class="oa-flag__sum">
        <span class="oa-flag__name">{{ cat.categoryName }}{% if cat.min > 0 %} <span class="text-danger" title="povinné">*</span>{% endif %}</span>
        <span class="oa-flag__val">
            {% for fo in selectedFlags %}
                {{ ui.flag_badge(fo.offer.flag.color, fo.offer.flag.shortName|default(fo.offer.flag.name|default(fo.offer.name)), fo.textValue) }}
            {% else %}
                <em class="oa-flag__empty">nenastaveno</em>
            {% endfor %}
        </span>
        <span class="oa-flag__edit"><twig:ux:icon name="tabler:pencil" class="oa-icon" /> upravit</span>
    </summary>
    <div class="oa-flag__editor">
        <form method="post" action="{{ path('oswis_org_oswis_calendar_web_admin_participant_edit_flags', { participantId: participant.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('participant_edit_flags_' ~ participant.id) }}">
            <input type="hidden" name="flagGroupOfferId" value="{{ cat.groupOffer.id }}">
            <p class="oa-flag__hint">
                {% if single %}Vyber jednu možnost{% else %}Vyber libovolný počet{% if cat.min > 0 %} (min&nbsp;{{ cat.min }}){% endif %}{% if cat.max is not null %} (max&nbsp;{{ cat.max }}){% endif %}{% endif %}
            </p>
            <div class="oa-opts">
                {% if single and cat.min == 0 %}
                    <label class="oa-opt">
                        <input type="radio" name="flagOfferIds[]" value="" {{ selectedFlags|length == 0 ? 'checked' : '' }}>
                        <span class="oa-opt__label oa-opt__label--none">— žádný —</span>
                    </label>
                {% endif %}
                {% for fo in cat.flagOffers %}
                    <label class="oa-opt{{ fo.full ? ' oa-opt--full' : '' }}">
                        {# ⚠️ Zakázat jde jen volbu, kterou účastník JEŠTĚ NEMÁ. Zakázaný prvek prohlížeč NEODESÍLÁ,
                           takže u už vybrané a mezitím naplněné volby by uložení jakékoli změny v téhle kategorii
                           jeho příznak TIŠE SMAZALO. #}
                        <input type="{{ single ? 'radio' : 'checkbox' }}" name="flagOfferIds[]" value="{{ fo.offer.id }}" {{ fo.selected ? 'checked' : '' }} {{ (fo.full and not fo.selected) ? 'disabled' : '' }}>
                        <span class="oa-opt__label">{{ fo.offer.flag.name|default(fo.offer.name|default('příznak')) }}</span>
                        {% if fo.offer.price|default(0) != 0 %}<span class="oa-opt__meta">{{ fo.offer.price > 0 ? '+' : '' }}{{ fo.offer.price }}&nbsp;Kč</span>{% endif %}
                        {% if fo.full %}<span class="oa-opt__full-tag">plné</span>{% endif %}
                        {% if fo.remaining is not null and not fo.full %}<span class="oa-opt__meta">zbývá {{ fo.remaining }}</span>{% endif %}
                    </label>
                    {% if fo.formValueAllowed %}
                        <div class="oa-opt__text-row">
                            <input type="text" name="flagTextValues[{{ fo.offer.id }}]" value="{{ fo.textValue|default('') }}"
                                   placeholder="{{ fo.formValueLabel|default('Upřesnění') }}" class="oa-opt__text form-control form-control-sm">
                        </div>
                    {% endif %}
                {% else %}
                    <em class="text-muted">žádné nabídky</em>
                {% endfor %}
            </div>
            <div class="oa-flag__actions">
                <button type="submit" class="btn btn-sm btn-primary">Uložit</button>
                <label class="oa-flag__override" title="Obejít naplněnou kapacitu">
                    {# Zaškrtnutí musí naplněné volby opravdu ZPŘÍSTUPNIT. Dřív jen odeslalo příznak
                       serveru, jenže volba zůstala `disabled`, takže ji nešlo ani vybrat, ani odeslat —
                       funkce byla nepoužitelná právě pro případ, kvůli kterému existuje. #}
                    <input type="checkbox" name="admin_override" value="1"> překročit kapacitu
                </label>
            </div>
        </form>
    </div>
</details>
