{% extends '@OswisOrgOswisCore/web_admin/page-skeleton-web-admin.html.twig' %}

{# Rozpracovaná stránka (2023) — zatím jen vypisuje základní údaje ročníků pod sebou, nic nesrovnává;
   co tu má být, čeká na rozhodnutí (audit 14. 9. 2026, O-body). Opravené jen značkování (V7): tabulky
   byly celé uvnitř jednoho <h3><small>, takže veškerý text měl nadpisové písmo, a pod nimi zůstaly
   prázdné řádky rozvržení. Teď nadpis ročníku + tabulka, stejně jako „Základní údaje" na detailu akce. #}
{% block body_content %}
    <main class="container" style="padding: 1rem 1.25rem 3rem;">
        <h2>Srovnání ročníků</h2>
        {% for event in events %}
            <h3>{{ event.shortName ?: event.name }}</h3>
            {% include '@OswisOrgOswisCalendar/web_admin/event-details-table.html.twig' %}
        {% else %}
            <p class="text-muted">Žádné ročníky.</p>
        {% endfor %}
    </main>
{% endblock body_content %}
