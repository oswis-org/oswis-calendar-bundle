{% extends '@OswisOrgOswisCore/e-mail/pages/message.html.twig' %}

{% block html_title %}{{ email.subject|default('Přehled nových plateb') }}{% endblock html_title %}

{% block content_outer %}
    <mj-text font-size="20px" font-weight="700" color="{{ oswis.colors.primary }}" align="center">
        Přehled nových plateb
    </mj-text>
    <mj-text>
        <table class="e-mail-list" style="border-collapse: collapse; border: 3px solid {{ oswis.colors.frame }}; margin: 1em auto; width: 100%;">
            <thead>
            <tr>
                <th style="min-width:25%;">ID<br><small>Externí ID</small><br><small>Datum platby</small><br><small>ID importu</small></th>
                <th style="min-width:25%;">Částka<br><small>Var. symbol (VS)</small><br><small>Typ platby</small></th>
                <th style="max-width:25%;">Účastník<br><small>Potvrzení na e-mail</small></th>
            </tr>
            </thead>
            {% for payment in payments|filter(payment => payment|default) %}
                <tbody>
                <tr style="border-top: 2px solid {{ oswis.colors.table_border }};">
                    <td>
                        <strong>ID {{ payment.id|default }}</strong><br>
                        {% if payment.externalId|default %}<small>EXT. ID: {{ payment.externalId|default }}</small><br>{% endif %}
                        {% if payment.dateTime|default %}<small>{{ payment.dateTime|date_or('j. n. Y') }}</small><br>{% endif %}
                        {% if payment.import.id|default %}<small>IMPORT {{ payment.import.id|default('0') }}</small><br>{% endif %}
                    </td>
                    <td>
                        {% set valueColor = payment.numericValue|default < 0 ? oswis.colors.danger : oswis.colors.success %}
                        <strong style="color: {{ valueColor }}">{{ payment.numericValue|default(0) }},-&nbsp;Kč</strong><br>
                        <small>VS: {{ payment.variableSymbol|default }}</small><br>
                        <small>{{ payment.typeLabel|default }}</small>
                    </td>
                    {% set assignedColor = payment.participant|default ? oswis.colors.success : oswis.colors.danger %}
                    {% set assignedBackgroundColor = payment.participant|default ? oswis.colors.success_tint : oswis.colors.danger_tint %}
                    <td style="background-color: {{ assignedBackgroundColor }};">
                        <strong style="color: {{ assignedColor }};">
                            {% if payment.participant.id|default %}
                                {{ payment.participant.id|default(0) }} | {{ payment.participant.name|default('<nepojmenovaný>') }}
                            {% else %}
                                ⚠️ NEPŘIŘAZENO ⚠️
                            {% endif %}
                        </strong><br>
                        <small>
                            {% if payment.confirmedByMailAt|default %}
                                {{ payment.confirmedByMailAt|date('j. n. Y, H:i') }}
                            {% else %}
                                Potvrzení neodesláno!
                            {% endif %}
                        </small>
                    </td>
                </tr>
                {% if payment.errorMessage %}
                    <tr><td style="background-color: {{ oswis.colors.danger_tint }}" colspan="3"><small>CHYBA: {{ payment.errorMessage }}</small></td></tr>
                {% endif %}
                {% if payment.note %}
                    <tr><td colspan="3"><small>Poznámka: {{ payment.note }}</small></td></tr>
                {% endif %}
                {% if payment.internalNote %}
                    <tr><td colspan="3"><small>Interní poznámka: {{ payment.internalNote }}</small></td></tr>
                {% endif %}
                {# Report chodí na archivní adresu týmu, ne účastníkům. Kdo poslal a co napsal
                   je tu to podstatné — dřív to bylo jen uvnitř syrového řádku z výpisu. #}
                {% if payment.counterpartyName|default %}
                    <tr><td colspan="3"><small>Od: {{ payment.counterpartyName }}{% if payment.counterpartyAccount|default %} ({{ payment.counterpartyAccount }}){% endif %}</small></td></tr>
                {% endif %}
                {% if payment.messageForRecipient|default %}
                    <tr><td colspan="3"><small>Zpráva pro příjemce: {{ payment.messageForRecipient }}</small></td></tr>
                {% endif %}
                </tbody>
            {% endfor %}
        </table>
    </mj-text>
{% endblock content_outer %}
